@model ThaiBeer.Core.Domain.Entities.DanhMuc
@{
    ViewData["Title"] = "Chỉnh Sửa Danh Mục: " + Model.TenDanhMuc;
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-stone-800">
        <div>
            <h1 class="text-2xl font-bold text-stone-100">Chỉnh Sửa Danh Mục</h1>
            <p class="text-xs text-stone-400 mt-1">Cập nhật thông tin danh mục sản phẩm</p>
        </div>
        <a href="/quan-tri/danh-muc" class="px-4 py-2 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-sm font-semibold transition">Quay lại</a>
    </div>

    <form method="post" action="/quan-tri/danh-muc/chinh-sua/@Model.Id" class="bg-stone-900 border border-stone-800 rounded-2xl p-6 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-950/80 border border-rose-600 text-rose-200 text-sm"></div>
        }

        <div>
            <label asp-for="TenDanhMuc" class="block text-xs font-semibold text-stone-300 mb-1.5">Tên danh mục <span class="text-rose-400">*</span></label>
            <input asp-for="TenDanhMuc" class="w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition" />
            <span asp-validation-for="TenDanhMuc" class="text-xs text-rose-400 mt-1 block font-medium"></span>
        </div>

        <div>
            <label asp-for="DuongDanSlug" class="block text-xs font-semibold text-stone-300 mb-1.5">Slug URL</label>
            <input asp-for="DuongDanSlug" class="w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 font-mono transition" />
            <span asp-validation-for="DuongDanSlug" class="text-xs text-rose-400 mt-1 block font-medium"></span>
        </div>

        <div>
            <label asp-for="MoTa" class="block text-xs font-semibold text-stone-300 mb-1.5">Mô tả danh mục</label>
            <textarea asp-for="MoTa" rows="3" class="w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition"></textarea>
        </div>

        <div>
            <label class="block text-xs font-semibold text-stone-300 mb-1.5">Tone Màu Thẻ Bộ Sưu Tập (Mã màu HEX)</label>
            <div class="flex items-center gap-3">
                <input type="color" id="pickerToneMau" value="@(string.IsNullOrEmpty(Model.ToneMau) ? "#007A29" : Model.ToneMau)" class="w-11 h-11 rounded-xl bg-transparent border border-stone-800 cursor-pointer p-1" oninput="document.getElementById('inputToneMau').value = this.value" />
                <input asp-for="ToneMau" id="inputToneMau" value="@(string.IsNullOrEmpty(Model.ToneMau) ? "#007A29" : Model.ToneMau)" class="flex-1 bg-stone-950 border border-stone-800 rounded-xl px-4 py-2.5 text-sm text-stone-100 font-mono focus:outline-none focus:border-amber-500 uppercase" placeholder="#007A29" oninput="document.getElementById('pickerToneMau').value = this.value" />
            </div>
            <div class="flex items-center gap-2 mt-2 pt-1 flex-wrap">
                <span class="text-xs text-stone-500">Màu gợi ý:</span>
                <button type="button" onclick="chonTone('#007A29')" class="w-6 h-6 rounded-full bg-[#007A29] border border-white/20 hover:scale-110 transition shadow" title="Xanh Heineken"></button>
                <button type="button" onclick="chonTone('#900C13')" class="w-6 h-6 rounded-full bg-[#900C13] border border-white/20 hover:scale-110 transition shadow" title="Đỏ Hoàng Gia ThaiBeer"></button>
                <button type="button" onclick="chonTone('#D4AF37')" class="w-6 h-6 rounded-full bg-[#D4AF37] border border-white/20 hover:scale-110 transition shadow" title="Vàng Hổ Phách"></button>
                <button type="button" onclick="chonTone('#D97706')" class="w-6 h-6 rounded-full bg-[#D97706] border border-white/20 hover:scale-110 transition shadow" title="Cam Đậm"></button>
                <button type="button" onclick="chonTone('#1E3A8A')" class="w-6 h-6 rounded-full bg-[#1E3A8A] border border-white/20 hover:scale-110 transition shadow" title="Xanh Navy"></button>
                <button type="button" onclick="chonTone('#0D9488')" class="w-6 h-6 rounded-full bg-[#0D9488] border border-white/20 hover:scale-110 transition shadow" title="Xanh Ngọc"></button>
            </div>
        </div>

        <script>
            function chonTone(hex) {
                document.getElementById('inputToneMau').value = hex;
                document.getElementById('pickerToneMau').value = hex;
            }
        </script>

        <div class="grid grid-cols-2 gap-4 pt-2">
            <div>
                <label asp-for="ThuTuHienThi" class="block text-xs font-semibold text-stone-300 mb-1.5">Thứ tự hiển thị</label>
                <input asp-for="ThuTuHienThi" type="number" class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-2.5 text-sm text-stone-100 focus:outline-none focus:border-amber-500" />
            </div>
            <div class="flex items-center gap-3 pt-6">
                <input asp-for="TrangThaiHoatDong" type="checkbox" id="checkTrangThai" class="w-4 h-4 rounded text-amber-500 focus:ring-amber-500 bg-stone-950 border-stone-800" />
                <label for="checkTrangThai" class="text-sm font-semibold text-stone-300">Đang hoạt động</label>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-stone-800">
            <a href="/quan-tri/danh-muc" class="px-5 py-2.5 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-sm font-semibold transition">Hủy</a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-sm font-bold shadow-lg shadow-amber-500/20 transition">Cập Nhật</button>
        </div>
    </form>
</div>

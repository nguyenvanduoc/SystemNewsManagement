@model ThaiBeer.Core.Domain.Entities.DanhMuc
@{
    ViewData["Title"] = "Thêm Danh Mục Mới";
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-stone-800">
        <div>
            <h1 class="text-2xl font-bold text-stone-100">Thêm Danh Mục Sản Phẩm</h1>
            <p class="text-xs text-stone-400 mt-1">Tạo nhóm sản phẩm như Bia chai, Bia lon, Craft...</p>
        </div>
        <a href="/quan-tri/danh-muc" class="px-4 py-2 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-sm font-semibold transition">Quay lại</a>
    </div>

    <form method="post" action="/quan-tri/danh-muc/them-moi" class="bg-stone-900 border border-stone-800 rounded-2xl p-6 space-y-5">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-rose-400 text-sm"></div>

        <div>
            <label asp-for="TenDanhMuc" class="block text-xs font-semibold text-stone-300 mb-1.5">Tên danh mục</label>
            <input asp-for="TenDanhMuc" class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-2.5 text-sm text-stone-100 focus:outline-none focus:border-amber-500" placeholder="VD: Bia Chai Cao Cấp" />
            <span asp-validation-for="TenDanhMuc" class="text-xs text-rose-400 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="DuongDanSlug" class="block text-xs font-semibold text-stone-300 mb-1.5">Slug URL (để trống tự sinh)</label>
            <input asp-for="DuongDanSlug" class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-2.5 text-sm text-stone-100 font-mono focus:outline-none focus:border-amber-500" placeholder="bia-chai-cao-cap" />
            <span asp-validation-for="DuongDanSlug" class="text-xs text-rose-400 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="MoTa" class="block text-xs font-semibold text-stone-300 mb-1.5">Mô tả danh mục</label>
            <textarea asp-for="MoTa" rows="3" class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-2.5 text-sm text-stone-100 focus:outline-none focus:border-amber-500"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4 pt-2">
            <div>
                <label asp-for="ThuTuHienThi" class="block text-xs font-semibold text-stone-300 mb-1.5">Thứ tự hiển thị</label>
                <input asp-for="ThuTuHienThi" type="number" class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-2.5 text-sm text-stone-100 focus:outline-none focus:border-amber-500" />
            </div>
            <div class="flex items-center gap-3 pt-6">
                <input asp-for="TrangThaiHoatDong" type="checkbox" id="checkTrangThai" class="w-4 h-4 rounded text-amber-500 focus:ring-amber-500 bg-stone-950 border-stone-800" />
                <label for="checkTrangThai" class="text-sm font-semibold text-stone-300">Đang hoạt động</label>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-stone-800">
            <a href="/quan-tri/danh-muc" class="px-5 py-2.5 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-sm font-semibold transition">Hủy</a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-sm font-bold shadow-lg shadow-amber-500/20 transition">Lưu Danh Mục</button>
        </div>
    </form>
</div>

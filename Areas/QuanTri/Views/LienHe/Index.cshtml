@model IEnumerable<ThaiBeer.Core.Domain.Entities.LienHe>
@{
    ViewData["Title"] = "Quản Lý Yêu Cầu Hợp Tác & Đại Lý";
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-stone-100">Yêu Cầu Hợp Tác & Đại Lý</h1>
        <p class="text-xs text-stone-400 mt-1">Danh sách khách hàng và đối tác đăng ký phân phối ThaiBeer</p>
    </div>
</div>

<div class="bg-stone-900 border border-stone-800 rounded-2xl overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-stone-300">
            <thead class="bg-stone-950/80 text-stone-400 uppercase text-[11px] font-bold tracking-wider border-b border-stone-800">
                <tr>
                    <th class="py-3.5 px-4">Ngày gửi</th>
                    <th class="py-3.5 px-4">Họ và Tên</th>
                    <th class="py-3.5 px-4">Số điện thoại</th>
                    <th class="py-3.5 px-4">Khu vực / Loại</th>
                    <th class="py-3.5 px-4">Ghi chú yêu cầu</th>
                    <th class="py-3.5 px-4 text-center">Trạng thái</th>
                    <th class="py-3.5 px-4 text-right">Xử lý</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-stone-800/80">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="py-8 text-center text-stone-500">Chưa có liên hệ nào trong hệ thống.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-stone-800/50 transition">
                            <td class="py-3 px-4 font-mono text-xs text-stone-400">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="py-3 px-4 font-bold text-stone-100">@item.HoTen</td>
                            <td class="py-3 px-4">
                                <a href="tel:@item.SoDienThoai" class="text-amber-400 hover:underline font-mono font-semibold">@item.SoDienThoai</a>
                                @if (!string.IsNullOrWhiteSpace(item.Email))
                                {
                                    <span class="block text-xs text-stone-500">@item.Email</span>
                                }
                            </td>
                            <td class="py-3 px-4">
                                <span class="text-xs font-semibold text-stone-200">@(item.DiaChiKhuVuc ?? "Chưa rõ")</span>
                                <span class="block text-[11px] text-stone-400">@item.LoaiHopTac</span>
                            </td>
                            <td class="py-3 px-4 max-w-xs text-xs text-stone-300">
                                @(item.NoiDungGhiChu ?? "Không có ghi chú")
                            </td>
                            <td class="py-3 px-4 text-center">
                                @if (item.DaXuLy)
                                {
                                    <span class="text-[11px] px-2.5 py-1 rounded-full bg-stone-800 text-stone-400 border border-stone-700">Đã tư vấn</span>
                                }
                                else
                                {
                                    <span class="text-[11px] px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold animate-pulse">Chưa xử lý</span>
                                }
                            </td>
                            <td class="py-3 px-4 text-right">
                                <form method="post" action="/quan-tri/lien-he/chuyen-trang-thai/@item.Id" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold @(item.DaXuLy ? "bg-stone-800 text-stone-300 hover:bg-stone-700" : "bg-emerald-600 text-white hover:bg-emerald-500") transition">
                                        @(item.DaXuLy ? "Đánh dấu chưa xử lý" : "Xác nhận đã liên hệ")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

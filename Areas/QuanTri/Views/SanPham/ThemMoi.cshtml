@model ThaiBeer.Areas.QuanTri.ViewModels.SanPhamUpsertViewModel
@{
    ViewData["Title"] = "Thêm Mới Sản Phẩm";
}

<div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-stone-800">
        <div>
            <h1 class="text-2xl font-bold text-stone-100">Thêm Mới Sản Phẩm ThaiBeer</h1>
            <p class="text-xs text-stone-400 mt-1">Ảnh tải lên sẽ tự động được nén sang định dạng WebP chất lượng cao</p>
        </div>
        <a href="/quan-tri/san-pham" class="px-4 py-2 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-sm font-semibold transition">
            <i class="fa-solid fa-arrow-left mr-1.5"></i> Quay lại
        </a>
    </div>

    <form method="post" action="/quan-tri/san-pham/them-moi" enctype="multipart/form-data" class="space-y-6">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-950/80 border border-rose-600 text-rose-200 text-sm mb-6 shadow-lg"></div>
        }

        <div class="bg-stone-900 border border-stone-800 rounded-2xl p-6 space-y-5">
            <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-2">Thông Tin Cơ Bản</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="TenSanPham" class="block text-xs font-semibold text-stone-300 mb-1.5">Tên sản phẩm <span class="text-rose-400">*</span></label>
                    <input asp-for="TenSanPham" id="inputTenSanPham" class="w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 placeholder-stone-500 transition" placeholder="VD: ThaiBeer Original Lager 330ml" />
                    <span asp-validation-for="TenSanPham" class="text-xs text-rose-400 mt-1 block font-medium"></span>
                </div>

                <div>
                    <label asp-for="DanhMucId" class="block text-xs font-semibold text-stone-300 mb-1.5">Danh mục sản phẩm <span class="text-rose-400">*</span></label>
                    <select asp-for="DanhMucId" asp-items="Model.DanhSachDanhMuc" class="w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="DanhMucId" class="text-xs text-rose-400 mt-1 block font-medium"></span>
                </div>
            </div>

            <div>
                <label asp-for="DuongDanSlug" class="block text-xs font-semibold text-stone-300 mb-1.5">
                    Đường dẫn thân thiện (Slug) <span class="text-stone-500 font-normal">(để trống sẽ tự sinh từ tên sản phẩm)</span>
                </label>
                <div class="flex gap-2">
                    <input asp-for="DuongDanSlug" id="inputSlug" class="flex-1 bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 font-mono transition" placeholder="thaibeer-original-lager-330ml" />
                    <button type="button" onclick="autoGenerateSlug()" class="px-3.5 py-2 bg-stone-800 hover:bg-stone-700 text-xs text-amber-400 border border-stone-700 rounded-xl font-semibold transition">
                        Tạo tự động
                    </button>
                </div>
                <span asp-validation-for="DuongDanSlug" class="text-xs text-rose-400 mt-1 block font-medium"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label asp-for="NongDoCon" class="block text-xs font-semibold text-stone-300 mb-1.5">Độ cồn (% ABV) <span class="text-rose-400">*</span></label>
                    <input asp-for="NongDoCon" type="number" step="0.1" class="w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition" />
                    <span asp-validation-for="NongDoCon" class="text-xs text-rose-400 mt-1 block font-medium"></span>
                </div>

                <div>
                    <label asp-for="DungTichMl" class="block text-xs font-semibold text-stone-300 mb-1.5">Dung tích (ml) <span class="text-rose-400">*</span></label>
                    <input asp-for="DungTichMl" type="number" class="w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition" />
                    <span asp-validation-for="DungTichMl" class="text-xs text-rose-400 mt-1 block font-medium"></span>
                </div>

                <div>
                    <label asp-for="XuatXu" class="block text-xs font-semibold text-stone-300 mb-1.5">Xuất xứ</label>
                    <input asp-for="XuatXu" class="w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition" />
                </div>

                <div>
                    <label asp-for="QuyCachDongGoi" class="block text-xs font-semibold text-stone-300 mb-1.5">Quy cách đóng gói</label>
                    <input asp-for="QuyCachDongGoi" class="w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition" placeholder="Két 24 chai 330ml" />
                </div>
            </div>

            <div>
                <label asp-for="MoTaNgan" class="block text-xs font-semibold text-stone-300 mb-1.5">Mô tả ngắn</label>
                <textarea asp-for="MoTaNgan" rows="3" class="w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition" placeholder="Tóm tắt ngắn gọn đặc tính nổi bật của sản phẩm bia..."></textarea>
                <span asp-validation-for="MoTaNgan" class="text-xs text-rose-400 mt-1 block font-medium"></span>
            </div>

            <div>
                <label asp-for="NoiDungChiTiet" class="block text-xs font-semibold text-stone-300 mb-1.5">Nội dung chi tiết (HTML)</label>
                <textarea asp-for="NoiDungChiTiet" rows="6" class="ckeditor-editor w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition" placeholder="Nội dung chi tiết quy trình ủ men, hương vị, giải thưởng (hỗ trợ thẻ HTML)..."></textarea>
            </div>
        </div>

        <!-- Media & Image Upload -->
        <div class="bg-stone-900 border border-stone-800 rounded-2xl p-6 space-y-5">
            <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-2">Hình Ảnh & Media</h2>

            <div>
                <label asp-for="TapTinHinhAnh" class="block text-xs font-semibold text-stone-300 mb-1.5"></label>
                <div class="border-2 border-dashed border-stone-800 hover:border-amber-500/50 rounded-2xl p-6 text-center transition bg-stone-950">
                    <input asp-for="TapTinHinhAnh" type="file" accept="image/*" id="fileImageInput" class="hidden" onchange="previewUploadImage(event)" />
                    <label for="fileImageInput" class="cursor-pointer block">
                        <i class="fa-solid fa-cloud-arrow-up text-3xl text-amber-500 mb-2"></i>
                        <p class="text-sm text-stone-300 font-semibold">Nhấn để chọn ảnh sản phẩm từ máy tính</p>
                        <p class="text-xs text-stone-500 mt-1">Định dạng JPG, PNG sẽ tự động chuyển sang WebP siêu nhẹ</p>
                    </label>
                    <div id="imagePreviewContainer" class="mt-4 hidden">
                        <img id="imagePreview" src="#" alt="Preview" class="w-32 h-32 object-contain mx-auto rounded-xl border border-amber-500/40 bg-white p-2" />
                    </div>
                </div>
                <span asp-validation-for="TapTinHinhAnh" class="text-xs text-rose-400 mt-1 block"></span>

                <!-- Hoặc nhập đường dẫn ảnh có sẵn -->
                <div class="mt-3 pt-3 border-t border-stone-800/80">
                    <label asp-for="HinhAnhHienTai" class="block text-xs font-semibold text-stone-300 mb-1.5">Hoặc dùng ảnh có sẵn trong hệ thống</label>
                    <div class="flex flex-wrap items-center gap-2">
                        <input asp-for="HinhAnhHienTai" id="inputHinhAnhHienTai" class="flex-1 min-w-[200px] bg-stone-950 border border-stone-800 rounded-xl px-4 py-2 text-xs text-stone-100 placeholder-stone-500 focus:outline-none focus:border-amber-500 font-mono" placeholder="/images/logo/BiaThai.png" />
                        <button type="button" onclick="useSampleImage('/images/logo/BiaThai.png')" class="px-2.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-[11px] text-amber-400 rounded-lg font-medium">Bia Thai</button>
                        <button type="button" onclick="useSampleImage('/images/logo/bia123zo.png')" class="px-2.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-[11px] text-amber-400 rounded-lg font-medium">123 Zô</button>
                        <button type="button" onclick="useSampleImage('/images/logo/123zolonlun.png')" class="px-2.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-[11px] text-amber-400 rounded-lg font-medium">Lon Lùn</button>
                    </div>
                </div>
            </div>

            <div>
                <label asp-for="VideoGioiThieuUrl" class="block text-xs font-semibold text-stone-300 mb-1.5"></label>
                <input asp-for="VideoGioiThieuUrl" class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-2.5 text-sm text-stone-100 focus:outline-none focus:border-amber-500" placeholder="https://www.youtube.com/embed/..." />
                <p class="text-[11px] text-stone-500 mt-1">Nhập link YouTube nhúng hoặc link video CDN (tuyệt đối không lưu file video lớn vào host)</p>
            </div>
        </div>

        <!-- Settings: Display & Order -->
        <div class="bg-stone-900 border border-stone-800 rounded-2xl p-6">
            <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider mb-4">Cấu Hình Hiển Thị</h2>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                <div class="flex items-center gap-3">
                    <input asp-for="HienThiTrangChu" type="checkbox" id="checkTrangChu" class="w-4 h-4 rounded text-amber-500 focus:ring-amber-500 bg-stone-950 border-stone-800" />
                    <label for="checkTrangChu" class="text-sm font-semibold text-stone-300">Nổi bật Trang Chủ</label>
                </div>

                <div class="flex items-center gap-3">
                    <input asp-for="TrangThaiHoatDong" type="checkbox" id="checkHoatDong" class="w-4 h-4 rounded text-amber-500 focus:ring-amber-500 bg-stone-950 border-stone-800" />
                    <label for="checkHoatDong" class="text-sm font-semibold text-stone-300">Đang hoạt động (Hiển thị)</label>
                </div>

                <div>
                    <label asp-for="ThuTuHienThi" class="block text-xs font-semibold text-stone-300 mb-1.5"></label>
                    <input asp-for="ThuTuHienThi" type="number" class="w-full bg-stone-950 border border-stone-800 rounded-xl px-4 py-2 text-sm text-stone-100 focus:outline-none focus:border-amber-500" />
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-4 pt-4">
            <a href="/quan-tri/san-pham" class="px-5 py-2.5 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-sm font-semibold transition">Hủy bỏ</a>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-sm font-bold shadow-lg shadow-amber-500/20 transition">
                <i class="fa-solid fa-floppy-disk mr-2"></i> Lưu Sản Phẩm
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>

        function previewUploadImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById('imagePreview');
                    img.src = e.target.result;
                    document.getElementById('imagePreviewContainer').classList.remove('hidden');
                }
                reader.readAsDataURL(file);
            }
        }

        function autoGenerateSlug() {
            const ten = document.getElementById('inputTenSanPham').value;
            if (!ten) return;
            let slug = ten.toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[đĐ]/g, 'd')
                .replace(/[^a-z0-9\s-]/g, '')
                .trim()
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
            document.getElementById('inputSlug').value = slug;
        }

        function useSampleImage(path) {
            document.getElementById('inputHinhAnhHienTai').value = path;
            const img = document.getElementById('imagePreview');
            img.src = path;
            document.getElementById('imagePreviewContainer').classList.remove('hidden');
        }
    </script>
}

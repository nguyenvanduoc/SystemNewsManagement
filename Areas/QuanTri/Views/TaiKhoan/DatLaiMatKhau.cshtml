@model DatLaiMatKhauViewModel
@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu";
    var inputCss = "w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition";
}

<div class="max-w-lg mx-auto">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-stone-800">
        <div>
            <h1 class="text-2xl font-bold text-stone-100">Đặt Lại Mật Khẩu</h1>
            <p class="text-xs text-stone-400 mt-1">Tài khoản: <span class="font-mono text-amber-400 font-bold">@Model.TenDangNhap</span></p>
        </div>
        <a href="/quan-tri/tai-khoan" class="px-4 py-2 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-sm font-semibold transition">Quay lại</a>
    </div>

    <form method="post" action="/quan-tri/tai-khoan/dat-lai-mat-khau/@Model.Id" class="bg-stone-900 border border-stone-800 rounded-2xl p-6 space-y-5" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TenDangNhap" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-950/80 border border-rose-600 text-rose-200 text-sm"></div>
        }

        <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs">
            Sau khi đặt lại: mọi phiên đăng nhập của tài khoản này bị đăng xuất, người dùng phải đổi sang mật khẩu riêng ở lần đăng nhập kế tiếp.
        </div>

        <div>
            <label asp-for="MatKhauMoi" class="block text-xs font-semibold text-stone-300 mb-1.5">Mật khẩu tạm mới <span class="text-rose-400">*</span></label>
            <input asp-for="MatKhauMoi" class="@inputCss" autocomplete="new-password" />
            <span asp-validation-for="MatKhauMoi" class="text-xs text-rose-400 mt-1 block font-medium"></span>
        </div>
        <div>
            <label asp-for="XacNhanMatKhauMoi" class="block text-xs font-semibold text-stone-300 mb-1.5">Nhập lại mật khẩu <span class="text-rose-400">*</span></label>
            <input asp-for="XacNhanMatKhauMoi" class="@inputCss" autocomplete="new-password" />
            <span asp-validation-for="XacNhanMatKhauMoi" class="text-xs text-rose-400 mt-1 block font-medium"></span>
        </div>
        <p class="text-[11px] text-stone-500">Mật khẩu tối thiểu 8 ký tự, gồm cả chữ và số.</p>

        <div class="flex justify-end">
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-sm font-bold transition">
                <i class="fa-solid fa-key mr-2"></i> Đặt Lại Mật Khẩu
            </button>
        </div>
    </form>
</div>

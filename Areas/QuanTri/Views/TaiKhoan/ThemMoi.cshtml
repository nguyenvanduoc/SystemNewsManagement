@using ThaiBeer.Core.Domain.Common
@model TaiKhoanThemMoiViewModel
@{
    ViewData["Title"] = "Thêm Tài Khoản";
    var inputCss = "w-full bg-stone-950 border border-stone-700 hover:border-stone-600 focus:border-amber-500 rounded-xl px-4 py-2.5 text-sm text-stone-100 transition";
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-stone-800">
        <div>
            <h1 class="text-2xl font-bold text-stone-100">Thêm Tài Khoản Quản Trị</h1>
            <p class="text-xs text-stone-400 mt-1">Người dùng mới sẽ bắt buộc đổi mật khẩu ở lần đăng nhập đầu tiên.</p>
        </div>
        <a href="/quan-tri/tai-khoan" class="px-4 py-2 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-sm font-semibold transition">Quay lại</a>
    </div>

    <form method="post" action="/quan-tri/tai-khoan/them-moi" class="bg-stone-900 border border-stone-800 rounded-2xl p-6 space-y-5" autocomplete="off">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-950/80 border border-rose-600 text-rose-200 text-sm"></div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label asp-for="TenDangNhap" class="block text-xs font-semibold text-stone-300 mb-1.5">Tên đăng nhập <span class="text-rose-400">*</span></label>
                <input asp-for="TenDangNhap" class="@inputCss font-mono" placeholder="vd: bientap01" />
                <span asp-validation-for="TenDangNhap" class="text-xs text-rose-400 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="VaiTro" class="block text-xs font-semibold text-stone-300 mb-1.5">Vai trò <span class="text-rose-400">*</span></label>
                <select asp-for="VaiTro" class="@inputCss">
                    <option value="@VaiTroNguoiDung.BienTapVien">Biên tập viên (quản lý nội dung)</option>
                    <option value="@VaiTroNguoiDung.QuanTriVien">Quản trị viên (toàn quyền + quản lý tài khoản)</option>
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label asp-for="HoTen" class="block text-xs font-semibold text-stone-300 mb-1.5">Họ và tên <span class="text-rose-400">*</span></label>
                <input asp-for="HoTen" class="@inputCss" />
                <span asp-validation-for="HoTen" class="text-xs text-rose-400 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-stone-300 mb-1.5">Email</label>
                <input asp-for="Email" class="@inputCss" />
                <span asp-validation-for="Email" class="text-xs text-rose-400 mt-1 block font-medium"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label asp-for="MatKhau" class="block text-xs font-semibold text-stone-300 mb-1.5">Mật khẩu tạm <span class="text-rose-400">*</span></label>
                <input asp-for="MatKhau" class="@inputCss" autocomplete="new-password" />
                <span asp-validation-for="MatKhau" class="text-xs text-rose-400 mt-1 block font-medium"></span>
            </div>
            <div>
                <label asp-for="XacNhanMatKhau" class="block text-xs font-semibold text-stone-300 mb-1.5">Nhập lại mật khẩu <span class="text-rose-400">*</span></label>
                <input asp-for="XacNhanMatKhau" class="@inputCss" autocomplete="new-password" />
                <span asp-validation-for="XacNhanMatKhau" class="text-xs text-rose-400 mt-1 block font-medium"></span>
            </div>
        </div>
        <p class="text-[11px] text-stone-500">Mật khẩu tối thiểu 8 ký tự, gồm cả chữ và số.</p>

        <div class="flex justify-end">
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-sm font-bold transition">
                <i class="fa-solid fa-floppy-disk mr-2"></i> Tạo Tài Khoản
            </button>
        </div>
    </form>
</div>

@model ThaiBeer.ViewModels.LienHeGuiYeuCauViewModel
@{
    ViewData["Title"] = "Liên Hệ & Hợp Tác Phân Phối";
    ViewData["Description"] = "Đăng ký trở thành đại lý phân phối, nhập sỉ đồ uống thượng hạng cho nhà hàng, quán bar và chuỗi bán lẻ.";
}

<!-- Header Banner (Heineken Style) -->
<div class="bg-[#E5E8E7] border-b border-gray-300 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-[#666666] mb-3">
            <a href="/" class="hover:text-[#007A29] transition">Trang Chủ</a>
            <span>/</span>
            <span class="text-[#222222] font-semibold">Liên Hệ</span>
        </nav>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#222222] uppercase tracking-tight">HỢP TÁC PHÂN PHỐI</h1>
        <div class="w-16 h-1 bg-[#007A29] mt-3"></div>
        <p class="text-xs sm:text-sm text-[#555555] mt-3 max-w-xl">
            Hưởng chính sách chiết khấu tốt nhất, hỗ trợ nhận diện thương hiệu, vật phẩm POSM và marketing đồng hành cùng đối tác trên toàn quốc.
        </p>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <!-- Left: Contact Details & Benefits -->
        <div class="lg:col-span-5 space-y-6">
            <div class="bg-white border border-gray-200 rounded-2xl p-8 space-y-6 shadow-sm">
                <div>
                    <h2 class="text-lg font-extrabold text-[#222222] uppercase tracking-tight flex items-center gap-2.5">
                        <i class="fa-solid fa-handshake text-[#007A29]"></i>
                        Đặc Quyền Dành Cho Đối Tác
                    </h2>
                    <div class="w-12 h-1 bg-[#007A29] mt-2"></div>
                </div>
                
                <ul class="space-y-4 text-xs sm:text-sm text-[#444444]">
                    <li class="flex items-start gap-3">
                        <span class="w-6 h-6 rounded-full bg-[#007A29]/10 text-[#007A29] flex items-center justify-center shrink-0 mt-0.5 font-bold">
                            <i class="fa-solid fa-check text-xs"></i>
                        </span>
                        <span>Chiết khấu trực tiếp trên từng đơn hàng hấp dẫn nhất thị trường.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="w-6 h-6 rounded-full bg-[#007A29]/10 text-[#007A29] flex items-center justify-center shrink-0 mt-0.5 font-bold">
                            <i class="fa-solid fa-check text-xs"></i>
                        </span>
                        <span>Hỗ trợ trọn gói vật phẩm quảng cáo (POSM), áo đồng phục và bảng hiệu chuẩn nhận diện.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="w-6 h-6 rounded-full bg-[#007A29]/10 text-[#007A29] flex items-center justify-center shrink-0 mt-0.5 font-bold">
                            <i class="fa-solid fa-check text-xs"></i>
                        </span>
                        <span>Giao hàng nhanh chóng và ổn định qua hệ thống kho vận chuyên nghiệp.</span>
                    </li>
                </ul>
            </div>

            <!-- Hotline Box (Heineken Deep Emerald) -->
            <div class="bg-[#003110] text-white rounded-2xl p-8 shadow-sm">
                <span class="text-xs text-[#A7F3D0] font-bold uppercase tracking-wider block mb-1">Đường Dây Nóng Hỗ Trợ Đối Tác</span>
                <a href="tel:0965156658" class="text-3xl font-black font-mono mt-2 block hover:underline">0965 156 658</a>
                <p class="text-xs text-gray-300 mt-2 leading-relaxed">Đội ngũ chuyên viên tư vấn phân phối sẵn sàng phản hồi nhanh chóng mọi thắc mắc của Quý đối tác.</p>
            </div>

            <!-- Address Box -->
            <div class="bg-white border border-gray-200 rounded-2xl p-8 space-y-4 shadow-sm">
                <div>
                    <h2 class="text-lg font-extrabold text-[#222222] uppercase tracking-tight flex items-center gap-2.5">
                        <i class="fa-solid fa-location-dot text-[#007A29]"></i>
                        Địa Chỉ Văn Phòng
                    </h2>
                    <div class="w-12 h-1 bg-[#007A29] mt-2"></div>
                </div>
                <div class="space-y-3 text-xs sm:text-sm text-[#444444]">
                    <div class="flex items-start gap-3">
                        <span class="w-7 h-7 rounded-full bg-[#007A29]/10 text-[#007A29] flex items-center justify-center shrink-0 mt-0.5">
                            <i class="fa-solid fa-building text-xs"></i>
                        </span>
                        <div class="leading-relaxed">
                            <span class="font-bold text-[#222222] block mb-0.5">Trụ sở công ty:</span>
                            <span>Số 108/4/1, đường Cộng Hòa, phường 4, quận Tân Bình, thành phố Hồ Chí Minh, Việt Nam</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Registration Form -->
        <div class="lg:col-span-7 bg-white border border-gray-200 rounded-2xl p-8 sm:p-10 shadow-sm">
            @if (TempData["GuiThanhCong"] != null)
            {
                <div class="mb-8 p-6 rounded-xl bg-emerald-50 border border-emerald-500 text-emerald-900 text-sm space-y-1">
                    <div class="flex items-center gap-2 font-bold text-base text-[#007A29]">
                        <i class="fa-solid fa-circle-check text-xl"></i>
                        Đăng Ký Thành Công!
                    </div>
                    <p>@TempData["GuiThanhCong"]</p>
                </div>
            }

            <div>
                <h2 class="text-xl font-extrabold text-[#222222] uppercase tracking-tight">Gửi Yêu Cầu Tư Vấn Mở Đại Lý</h2>
                <div class="w-16 h-1 bg-[#007A29] mt-2 mb-2"></div>
                <p class="text-xs text-[#666666] mb-6">Vui lòng điền thông tin bên dưới, chuyên viên phân phối sẽ phản hồi ngay.</p>
            </div>

            <form method="post" action="/lien-he" class="space-y-5">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="HoTen" class="block text-xs font-semibold text-[#222222] mb-1.5"></label>
                        <input asp-for="HoTen" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-[#222222] focus:outline-none focus:border-[#007A29] focus:ring-1 focus:ring-[#007A29]" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="HoTen" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="SoDienThoai" class="block text-xs font-semibold text-[#222222] mb-1.5"></label>
                        <input asp-for="SoDienThoai" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-[#222222] focus:outline-none focus:border-[#007A29] focus:ring-1 focus:ring-[#007A29]" placeholder="0965 xxx xxx" />
                        <span asp-validation-for="SoDienThoai" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="Email" class="block text-xs font-semibold text-[#222222] mb-1.5"></label>
                        <input asp-for="Email" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-[#222222] focus:outline-none focus:border-[#007A29] focus:ring-1 focus:ring-[#007A29]" placeholder="nhuttrongchau@gmail.com" />
                        <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="DiaChiKhuVuc" class="block text-xs font-semibold text-[#222222] mb-1.5"></label>
                        <input asp-for="DiaChiKhuVuc" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-[#222222] focus:outline-none focus:border-[#007A29] focus:ring-1 focus:ring-[#007A29]" placeholder="VD: Hà Nội, TP.HCM, Đà Nẵng..." />
                    </div>
                </div>

                <div>
                    <label asp-for="LoaiHopTac" class="block text-xs font-semibold text-[#222222] mb-1.5"></label>
                    <select asp-for="LoaiHopTac" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-[#222222] focus:outline-none focus:border-[#007A29] focus:ring-1 focus:ring-[#007A29]">
                        <option value="Đại lý phân phối cấp 1 tỉnh/thành">Đại lý phân phối cấp 1 tỉnh/thành</option>
                        <option value="Nhà hàng, Quán ăn, Beer Club, Lounge">Nhà hàng, Quán ăn, Beer Club, Lounge</option>
                        <option value="Khách sạn, Resort cao cấp">Khách sạn, Resort cao cấp</option>
                        <option value="Chuỗi siêu thị, Cửa hàng tiện lợi">Chuỗi siêu thị, Cửa hàng tiện lợi</option>
                        <option value="Mua số lượng lớn cho sự kiện, tiệc cưới">Mua số lượng lớn cho sự kiện, tiệc cưới</option>
                    </select>
                </div>

                <div>
                    <label asp-for="NoiDungGhiChu" class="block text-xs font-semibold text-[#222222] mb-1.5"></label>
                    <textarea asp-for="NoiDungGhiChu" rows="4" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-[#222222] focus:outline-none focus:border-[#007A29] focus:ring-1 focus:ring-[#007A29]" placeholder="Quy mô dự kiến, số lượng thùng hàng tháng hoặc địa điểm kinh doanh..."></textarea>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full py-3.5 rounded-full bg-[#007A29] hover:bg-[#006020] text-white font-bold text-xs uppercase tracking-wider shadow-md transition hover:scale-[1.01]">
                        <i class="fa-solid fa-paper-plane mr-2"></i> Gửi Yêu Cầu Hợp Tác Ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


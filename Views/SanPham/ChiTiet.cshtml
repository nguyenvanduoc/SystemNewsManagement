@model ThaiBeer.ViewModels.SanPhamChiTietViewModel
@{
    var sp = Model.SanPham;
    ViewData["Title"] = sp.TenSanPham;
    ViewData["Description"] = sp.MoTaNgan ?? sp.TenSanPham;
}

<div class="bg-thaicard border-b border-stone-800 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-stone-500">
            <a href="/" class="hover:text-amber-400 transition">Trang Chủ</a>
            <span>/</span>
            <a href="/san-pham" class="hover:text-amber-400 transition">Sản Phẩm</a>
            <span>/</span>
            @if (sp.DanhMuc != null)
            {
                <a href="/danh-muc/@sp.DanhMuc.DuongDanSlug" class="hover:text-amber-400 transition">@sp.DanhMuc.TenDanhMuc</a>
                <span>/</span>
            }
            <span class="text-amber-400 font-semibold truncate">@sp.TenSanPham</span>
        </nav>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Main Product Detail Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 bg-thaicard border border-stone-800 rounded-3xl p-6 sm:p-10 shadow-2xl">
        <!-- Left: Image Preview -->
        <div class="lg:col-span-5 flex items-center justify-center bg-stone-900/80 rounded-2xl p-8 border border-stone-800/80 relative">
            <img src="@sp.HinhAnhWebP" alt="@sp.TenSanPham" class="max-h-[460px] w-auto object-contain drop-shadow-[0_20px_25px_rgba(0,0,0,0.8)]" />
            <div class="absolute top-4 left-4 bg-stone-950/80 backdrop-blur-md px-3 py-1.5 rounded-xl border border-amber-500/30 text-xs font-bold text-amber-400">
                Thương hiệu Thái Lan
            </div>
        </div>

        <!-- Right: Specifications & Info -->
        <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
            <div>
                <div class="inline-block px-3 py-1 rounded-lg bg-amber-500/10 text-amber-400 text-xs font-bold uppercase tracking-wider mb-2 border border-amber-500/20">
                    @(sp.DanhMuc?.TenDanhMuc ?? "ThaiBeer")
                </div>
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-stone-100 leading-tight">
                    @sp.TenSanPham
                </h1>
                <p class="text-xs text-stone-500 font-mono mt-1">Mã sản phẩm: TB-@sp.Id | Đã xem: @(sp.LuotXem + 1) lần</p>

                <p class="text-sm text-stone-300 mt-4 leading-relaxed">
                    @sp.MoTaNgan
                </p>

                <!-- Technical Specs Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6">
                    <div class="bg-thaidark border border-stone-800 rounded-xl p-3.5 text-center">
                        <span class="text-[11px] text-stone-500 uppercase font-semibold block">Nồng Độ Cồn</span>
                        <span class="text-lg font-black text-amber-400 mt-0.5 block">@sp.NongDoCon% ABV</span>
                    </div>
                    <div class="bg-thaidark border border-stone-800 rounded-xl p-3.5 text-center">
                        <span class="text-[11px] text-stone-500 uppercase font-semibold block">Dung Tích</span>
                        <span class="text-lg font-black text-stone-100 mt-0.5 block">@sp.DungTichMl ml</span>
                    </div>
                    <div class="bg-thaidark border border-stone-800 rounded-xl p-3.5 text-center">
                        <span class="text-[11px] text-stone-500 uppercase font-semibold block">Xuất Xứ</span>
                        <span class="text-lg font-black text-stone-100 mt-0.5 block">@sp.XuatXu</span>
                    </div>
                    <div class="bg-thaidark border border-stone-800 rounded-xl p-3.5 text-center">
                        <span class="text-[11px] text-stone-500 uppercase font-semibold block">Quy Cách</span>
                        <span class="text-xs font-bold text-stone-300 mt-1.5 block line-clamp-1">@sp.QuyCachDongGoi</span>
                    </div>
                </div>
            </div>

            <!-- CTA Actions -->
            <div class="pt-6 border-t border-stone-800 space-y-4">
                <div class="flex flex-wrap items-center gap-4">
                    <a href="/lien-he" class="flex-1 text-center py-4 px-6 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-600 hover:from-amber-400 hover:to-yellow-500 text-stone-950 font-extrabold text-sm uppercase tracking-wider shadow-lg shadow-amber-500/30 transition hover:scale-105">
                        <i class="fa-solid fa-handshake mr-2"></i> Liên Hệ Mua Đại Lý / Sỉ
                    </a>
                    <a href="tel:19008888" class="py-4 px-6 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-100 font-bold text-sm border border-stone-700 transition">
                        <i class="fa-solid fa-phone mr-1.5 text-amber-400"></i> 1900 8888
                    </a>
                </div>
                <p class="text-[11px] text-stone-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-truck-fast text-amber-500"></i> Hỗ trợ vận chuyển tận nơi cho nhà hàng, quán bar và nhà phân phối toàn quốc.
                </p>
            </div>
        </div>
    </div>

    <!-- Video Embed or Detailed Content -->
    @if (!string.IsNullOrWhiteSpace(sp.VideoGioiThieuUrl))
    {
        <div class="mt-12 bg-thaicard border border-stone-800 rounded-3xl p-6 sm:p-8">
            <h2 class="text-xl font-bold text-stone-100 mb-4 flex items-center gap-2">
                <i class="fa-brands fa-youtube text-red-500"></i> Video Giới Thiệu
            </h2>
            <div class="aspect-video rounded-2xl overflow-hidden">
                <iframe src="@sp.VideoGioiThieuUrl" class="w-full h-full" frameborder="0" allowfullscreen></iframe>
            </div>
        </div>
    }

    <!-- Rich HTML Content -->
    @if (!string.IsNullOrWhiteSpace(sp.NoiDungChiTiet))
    {
        <div class="mt-12 bg-thaicard border border-stone-800 rounded-3xl p-6 sm:p-10">
            <h2 class="text-xl font-bold text-stone-100 mb-6 border-b border-stone-800 pb-4 flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-amber-400"></i> Thông Tin Chi Tiết & Hướng Dẫn Thưởng Thức
            </h2>
            <div class="prose prose-invert prose-amber max-w-none text-sm text-stone-300 leading-relaxed space-y-4">
                @Html.Raw(sp.NoiDungChiTiet)
            </div>
        </div>
    }

    <!-- Related Products -->
    @if (Model.SanPhamLienQuan.Any())
    {
        <div class="mt-16">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-2xl font-black text-stone-100">Sản Phẩm Cùng Dòng Bia</h2>
                <a href="/san-pham" class="text-xs text-amber-400 font-bold hover:underline">Xem thêm</a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var lq in Model.SanPhamLienQuan)
                {
                    <div class="bg-thaicard border border-stone-800 rounded-2xl overflow-hidden group hover:border-amber-500/50 transition-all duration-300 shadow-lg flex flex-col justify-between">
                        <a href="/san-pham/@lq.DuongDanSlug" class="block relative bg-stone-900 aspect-square p-4 flex items-center justify-center cursor-pointer group-hover:bg-stone-800/80 transition-colors">
                            <img src="@lq.HinhAnhWebP" alt="@lq.TenSanPham" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" loading="lazy" />
                            <div class="absolute top-3 left-3 bg-stone-950/80 px-2 py-0.5 rounded text-[10px] font-bold text-amber-400">
                                @lq.NongDoCon% ABV
                            </div>
                        </a>
                        <div class="p-4">
                            <h3 class="font-bold text-sm text-stone-200 line-clamp-1 group-hover:text-amber-400">
                                <a href="/san-pham/@lq.DuongDanSlug">@lq.TenSanPham</a>
                            </h3>
                            <div class="flex items-center justify-between mt-3 pt-3 border-t border-stone-800">
                                <span class="text-xs text-stone-500">@lq.DungTichMl ml</span>
                                <a href="/san-pham/@lq.DuongDanSlug" class="text-xs font-bold text-amber-400 hover:underline">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@model ThaiBeer.ViewModels.SanPhamChiTietViewModel
@{
    var sp = Model.SanPham;
    ViewData["Title"] = sp.TenSanPham;
    ViewData["Description"] = sp.MoTaNgan ?? sp.TenSanPham;

    // Danh sách hình ảnh bộ sưu tập: Mặc định ảnh chính là ảnh đầu tiên, tiếp theo là tối đa 4 ảnh chi tiết
    var allImages = new List<string>();
    if (!string.IsNullOrWhiteSpace(sp.HinhAnhWebP))
    {
        allImages.Add(sp.HinhAnhWebP);
    }

    if (sp.HinhAnhPhus != null && sp.HinhAnhPhus.Any())
    {
        foreach (var h in sp.HinhAnhPhus.OrderBy(x => x.ThuTu).Take(4))
        {
            if (!string.IsNullOrWhiteSpace(h.DuongDanWebP) && !allImages.Contains(h.DuongDanWebP))
            {
                allImages.Add(h.DuongDanWebP);
            }
        }
    }
    else if (!string.IsNullOrWhiteSpace(sp.DanhSachHinhAnhPhu))
    {
        var phuArr = sp.DanhSachHinhAnhPhu.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var item in phuArr.Take(4))
        {
            var trimmed = item.Trim();
            if (!string.IsNullOrWhiteSpace(trimmed) && !allImages.Contains(trimmed))
            {
                allImages.Add(trimmed);
            }
        }
    }

    if (!allImages.Any())
    {
        allImages.Add("/images/logo/BiaThai.png");
    }
}

<!-- Breadcrumbs Bar -->
<div class="bg-[#E5E8E7] border-b border-gray-300 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-[#666666]">
            <a href="/" class="hover:text-[#007A29] transition">Trang Chủ</a>
            <span>/</span>
            <a href="/san-pham" class="hover:text-[#007A29] transition">Sản Phẩm</a>
            <span>/</span>
            @if (sp.DanhMuc != null)
            {
                <a href="/danh-muc/@sp.DanhMuc.DuongDanSlug" class="hover:text-[#007A29] transition">@sp.DanhMuc.TenDanhMuc</a>
                <span>/</span>
            }
            <span class="text-[#007A29] font-bold truncate">@sp.TenSanPham</span>
        </nav>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Main Product Detail Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Cột Khung Hình Ảnh & Bộ Sưu Tập Ảnh Chi Tiết (Tối đa 5 ảnh: 1 chính + 4 phụ) -->
        <div class="lg:col-span-6 xl:col-span-5 select-none space-y-3">
            <!-- 1. KHUNG ẢNH LỚN CHÍNH -->
            <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm relative group aspect-[4/3] flex items-center justify-center p-4">
                <a id="mainImageLink" 
                   href="@allImages[0]" 
                   data-fancybox="product_gallery" 
                   data-caption="@sp.TenSanPham (Ảnh 1/@allImages.Count)"
                   title="Nhấp để xem ảnh phóng to"
                   class="w-full h-full flex items-center justify-center cursor-zoom-in">
                    <img id="mainProductImage" 
                         src="@allImages[0]" 
                         alt="@sp.TenSanPham" 
                         class="max-h-full max-w-full object-contain transition-all duration-300 group-hover:scale-105" 
                         loading="eager" />
                </a>

                <!-- Badge đếm số thứ tự ảnh (Ví dụ: 1/5, 3/5 như ảnh mẫu) -->
                @if (allImages.Count > 1)
                {
                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-black/60 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1 rounded-full pointer-events-none shadow-md">
                        <span id="galleryCurrentIndex">1</span>/@allImages.Count
                    </div>
                }

                <!-- Nút kính lúp zoom góc phải -->
                <div class="absolute top-4 right-4 bg-black/40 hover:bg-black/60 text-white w-9 h-9 rounded-full flex items-center justify-center text-sm backdrop-blur-sm pointer-events-none transition shadow">
                    <i class="fa-solid fa-magnifying-glass-plus"></i>
                </div>
            </div>

            <!-- 2. DẢI THUMBNAIL BÊN DƯỚI (Có 2 nút điều hướng mũi tên trái/phải tương tự ảnh mẫu) -->
            @if (allImages.Count > 1)
            {
                <div class="relative px-7">
                    <!-- Nút Previous Thumbnail -->
                    <button type="button" 
                            id="thumbPrevBtn" 
                            class="absolute left-0 top-1/2 -translate-y-1/2 w-6 h-6 bg-white hover:bg-gray-100 border border-gray-300 rounded-full flex items-center justify-center text-gray-700 shadow-sm transition hover:scale-110 active:scale-95 z-10"
                            aria-label="Ảnh trước">
                        <i class="fa-solid fa-chevron-left text-[10px]"></i>
                    </button>

                    <!-- Danh sách Thumbnails -->
                    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1" id="thumbStrip">
                        @for (int i = 0; i < allImages.Count; i++)
                        {
                            var imgUrl = allImages[i];
                            <button type="button"
                                    class="thumb-item relative flex-1 min-w-[60px] aspect-[4/3] bg-white border-2 rounded-xl overflow-hidden p-1 transition-all @(i == 0 ? "border-[#007A29] shadow-sm ring-2 ring-[#007A29]/20 opacity-100" : "border-gray-200 hover:border-gray-400 opacity-60 hover:opacity-100")"
                                    data-index="@i"
                                    data-src="@imgUrl"
                                    onclick="selectProductImage(@i, '@imgUrl')">
                                <img src="@imgUrl" 
                                     alt="@sp.TenSanPham - Ảnh @(i + 1)" 
                                     class="w-full h-full object-contain" 
                                     loading="lazy" />
                            </button>
                        }
                    </div>

                    <!-- Nút Next Thumbnail -->
                    <button type="button" 
                            id="thumbNextBtn" 
                            class="absolute right-0 top-1/2 -translate-y-1/2 w-6 h-6 bg-white hover:bg-gray-100 border border-gray-300 rounded-full flex items-center justify-center text-gray-700 shadow-sm transition hover:scale-110 active:scale-95 z-10"
                            aria-label="Ảnh kế tiếp">
                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                    </button>
                </div>
            }

            <!-- Ẩn các link phụ để Fancybox duyệt đủ album ảnh khi bấm zoom -->
            <div class="hidden">
                @for (int i = 1; i < allImages.Count; i++)
                {
                    <a href="@allImages[i]" data-fancybox="product_gallery" data-caption="@sp.TenSanPham (Ảnh @(i + 1)/@allImages.Count)"></a>
                }
            </div>
        </div>

        <!-- Cột Thông Tin Sản Phẩm Chuẩn 100% ThaiBeer.vn -->
        <div class="lg:col-span-6 xl:col-span-7 space-y-4">
            <!-- Tiêu đề sản phẩm (không viết hoa toàn bộ chuẩn thaibeer.vn) -->
            <h1 class="text-2xl sm:text-[28px] lg:text-3xl font-bold text-[#111111] leading-tight font-['Montserrat',sans-serif]">
                @sp.TenSanPham
            </h1>

            <!-- Mã sản phẩm & Lượt xem (Lấy trực tiếp từ bảng SanPhams cột LuotXem) -->
            <div class="flex items-center gap-3 text-xs text-[#555555]">
                <span>Mã sản phẩm: <strong class="text-[#B30D14] font-semibold">SP-@sp.Id.ToString("D4")</strong></span>
                <span class="text-gray-300">|</span>
                <span>Lượt xem: <strong class="text-[#B30D14] font-semibold">@sp.LuotXem.ToString("N0")</strong></span>
            </div>

            <!-- Giá: Liên hệ chuẩn thaibeer.vn -->
            <div class="text-2xl sm:text-[26px] font-bold text-[#B30D14]">
                Liên hệ
            </div>

            <!-- Khung Mô Tả Màu Đỏ Chuẩn ThaiBeer.vn (Tăng lên 1 size) -->
            <div class="bg-[#B30D14] text-white p-5 sm:p-6 rounded-xl text-sm sm:text-base leading-relaxed sm:leading-loose shadow-sm font-normal">
                @if (!string.IsNullOrWhiteSpace(sp.MoTaNgan))
                {
                    @sp.MoTaNgan
                }
                else
                {
                    <span>Mẫu lon: Thấp (Lùn) Thành phần: Nước, mạch nha đại mạch, hoa bia, men bia. Hướng dẫn sử dụng và bảo quản: Ngon hơn khi uống lạnh tốt nhất ở 10°C-15°C. Bảo quản ở nơi khô ráo và thoáng mát. NSX-HSD: Xem ở đáy lon.</span>
                }
            </div>

            <!-- Thông số kỹ thuật -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
                <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 text-center">
                    <span class="text-[11px] text-gray-500 uppercase font-semibold block">Độ Cồn</span>
                    <span class="text-base font-black text-[#007A29] block mt-0.5">@sp.NongDoCon% Độ cồn</span>
                </div>
                <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 text-center">
                    <span class="text-[11px] text-gray-500 uppercase font-semibold block">Dung Tích</span>
                    <span class="text-base font-black text-[#222222] block mt-0.5">@sp.DungTichMl ml</span>
                </div>
                <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 text-center">
                    <span class="text-[11px] text-gray-500 uppercase font-semibold block">Xuất Xứ</span>
                    <span class="text-base font-black text-[#222222] block mt-0.5">@sp.XuatXu</span>
                </div>
                <div class="bg-gray-50 border border-gray-200 rounded-xl p-3 text-center">
                    <span class="text-[11px] text-gray-500 uppercase font-semibold block">Quy Cách</span>
                    <span class="text-xs font-bold text-[#444444] block mt-1 truncate">@sp.QuyCachDongGoi</span>
                </div>
            </div>

            <!-- CTA Actions (Liên Hệ Đại Lý / Đặt Hàng Chuẩn B2B) -->
            <div class="pt-4 border-t border-gray-100 space-y-3">
                <div class="flex flex-wrap items-center gap-4">
                    <a href="/lien-he" class="flex-1 text-center py-3.5 px-6 rounded-full bg-[#007A29] hover:bg-[#006020] text-white font-bold text-xs uppercase tracking-wider shadow-md transition hover:scale-[1.02] flex items-center justify-center gap-2">
                        <i class="fa-solid fa-handshake"></i>
                        <span>LIÊN HỆ MUA ĐẠI LÝ / ĐẶT HÀNG</span>
                    </a>
                    <a href="tel:0965156658" class="py-3.5 px-6 rounded-full bg-white hover:bg-gray-100 text-[#222222] font-bold text-xs border border-gray-300 transition shadow-sm flex items-center justify-center gap-2">
                        <i class="fa-solid fa-phone text-[#007A29]"></i>
                        <span>Hotline: 0965 156 658</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Video Embed or Detailed Content -->
    @if (!string.IsNullOrWhiteSpace(sp.VideoGioiThieuUrl))
    {
        <div class="mt-12 bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm">
            <h2 class="text-lg font-bold text-[#222222] mb-4 flex items-center gap-2 uppercase">
                <i class="fa-brands fa-youtube text-[#E31B23]"></i> Video Giới Thiệu
            </h2>
            <div class="aspect-video rounded-xl overflow-hidden border border-gray-200">
                <iframe src="@sp.VideoGioiThieuUrl" class="w-full h-full" frameborder="0" allowfullscreen></iframe>
            </div>
        </div>
    }


    <!-- Related Products -->
    @if (Model.SanPhamLienQuan.Any())
    {
        <div class="mt-16">
            <div class="flex items-end justify-between mb-8">
                <div>
                    <h2 class="text-xl sm:text-2xl font-extrabold text-[#222222] uppercase tracking-tight">Sản Phẩm Cùng Dòng</h2>
                    <div class="w-16 h-1 bg-[#007A29] mt-2"></div>
                </div>
                <a href="/san-pham" class="text-xs text-[#007A29] font-bold hover:underline inline-flex items-center gap-1">
                    Xem thêm <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                @foreach (var lq in Model.SanPhamLienQuan)
                {
                    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden group hover:border-[#007A29] transition-all duration-300 hover:-translate-y-1.5 shadow-sm hover:shadow-lg flex flex-col justify-between">
                        <!-- Khối ảnh có link điều hướng: Đảm bảo luôn flex căn giữa 100% trên cả mobile và desktop -->
                        <a href="/san-pham/@lq.DuongDanSlug" class="relative w-full bg-white aspect-square overflow-hidden p-6 flex items-center justify-center cursor-pointer group-hover:bg-gray-50/50 transition-colors border-b border-gray-100" style="display: flex !important; align-items: center !important; justify-content: center !important;">
                            <img src="@lq.HinhAnhWebP" alt="@lq.TenSanPham" class="max-h-full max-w-full w-auto h-auto object-contain mx-auto my-auto group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                            <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-md border border-gray-200 text-[11px] font-bold text-[#007A29] shadow-sm">
                                @lq.NongDoCon% Độ cồn
                            </div>
                            <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-md border border-gray-200 text-[11px] font-medium text-[#666666] shadow-sm">
                                @lq.DungTichMl ml
                            </div>
                        </a>

                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <!-- Khối text (Danh mục, Tiêu đề, Mô tả) có link điều hướng -->
                            <a href="/san-pham/@lq.DuongDanSlug" class="block group/text cursor-pointer">
                                <span class="text-[11px] font-bold text-[#007A29] uppercase tracking-wider block mb-1">
                                    @(lq.DanhMuc?.TenDanhMuc ?? "BIA THÁI")
                                </span>
                                <h3 class="text-base font-bold text-[#222222] line-clamp-1 group-hover/text:text-[#007A29] transition-colors">
                                    @lq.TenSanPham
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(lq.MoTaNgan))
                                {
                                    <p class="text-xs text-[#666666] mt-2 line-clamp-2 leading-relaxed">
                                        @lq.MoTaNgan
                                    </p>
                                }
                            </a>

                            <div class="pt-4 mt-4 border-t border-gray-100 flex items-center justify-between">
                                <span class="text-xs text-[#666666] font-medium">@lq.QuyCachDongGoi</span>
                                <a href="/san-pham/@lq.DuongDanSlug" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-[#007A29] hover:bg-[#006020] text-white font-bold text-xs transition shadow-sm">
                                    <span>Chi tiết</span>
                                    <i class="fa-solid fa-chevron-right text-[9px]"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const galleryImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allImages));
        let currentGalleryIndex = 0;

        function selectProductImage(index, src) {
            if (index < 0 || index >= galleryImages.length) return;
            currentGalleryIndex = index;

            // Cập nhật ảnh chính
            const mainImg = document.getElementById("mainProductImage");
            const mainLink = document.getElementById("mainImageLink");
            const indexCounter = document.getElementById("galleryCurrentIndex");

            if (mainImg) {
                mainImg.style.opacity = '0.3';
                mainImg.src = src;
                setTimeout(() => { mainImg.style.opacity = '1'; }, 120);
            }
            if (mainLink) {
                mainLink.href = src;
                mainLink.setAttribute("data-caption", `@sp.TenSanPham (Ảnh ${index + 1}/${galleryImages.length})`);
            }
            if (indexCounter) {
                indexCounter.textContent = (index + 1);
            }

            // Cập nhật viền active cho các thumbnail
            document.querySelectorAll(".thumb-item").forEach((thumb, idx) => {
                if (idx === index) {
                    thumb.classList.remove("border-gray-200", "opacity-60");
                    thumb.classList.add("border-[#007A29]", "shadow-sm", "ring-2", "ring-[#007A29]/20", "opacity-100");
                    thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                } else {
                    thumb.classList.remove("border-[#007A29]", "shadow-sm", "ring-2", "ring-[#007A29]/20", "opacity-100");
                    thumb.classList.add("border-gray-200", "opacity-60");
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function() {
            const prevBtn = document.getElementById("thumbPrevBtn");
            const nextBtn = document.getElementById("thumbNextBtn");

            if (prevBtn) {
                prevBtn.addEventListener("click", function() {
                    let nextIdx = (currentGalleryIndex - 1 + galleryImages.length) % galleryImages.length;
                    selectProductImage(nextIdx, galleryImages[nextIdx]);
                });
            }
            if (nextBtn) {
                nextBtn.addEventListener("click", function() {
                    let nextIdx = (currentGalleryIndex + 1) % galleryImages.length;
                    selectProductImage(nextIdx, galleryImages[nextIdx]);
                });
            }
        });
    </script>
}


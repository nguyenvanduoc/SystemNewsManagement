@model ThaiBeer.ViewModels.SanPhamChiTietViewModel
@{
    var sp = Model.SanPham;
    ViewData["Title"] = sp.TenSanPham;
    ViewData["Description"] = sp.MoTaNgan ?? sp.TenSanPham;
}

<!-- Breadcrumbs Bar -->
<div class="bg-[#E5E8E7] border-b border-gray-300 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-[#666666]">
            <a href="/" class="hover:text-[#007A29] transition">Trang Chủ</a>
            <span>/</span>
            <a href="/san-pham" class="hover:text-[#007A29] transition">Sản Phẩm</a>
            <span>/</span>
            @if (sp.DanhMuc != null)
            {
                <a href="/danh-muc/@sp.DanhMuc.DuongDanSlug" class="hover:text-[#007A29] transition">@sp.DanhMuc.TenDanhMuc</a>
                <span>/</span>
            }
            <span class="text-[#007A29] font-bold truncate">@sp.TenSanPham</span>
        </nav>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Main Product Detail Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 bg-white border border-gray-200 rounded-2xl p-6 sm:p-10 shadow-sm">
        <!-- Left: Image Preview -->
        <div class="lg:col-span-5 flex items-center justify-center bg-[#F8F9FA] rounded-xl p-8 border border-gray-200 relative">
            <img src="@sp.HinhAnhWebP" alt="@sp.TenSanPham" class="max-h-[440px] w-auto object-contain drop-shadow-md" />
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-md border border-gray-200 text-xs font-bold text-[#007A29] shadow-sm">
                Đồ Uống Thượng Hạng
            </div>
        </div>

        <!-- Right: Specifications & Info -->
        <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
            <div>
                <div class="inline-block px-3 py-1 rounded-full bg-[#007A29]/10 text-[#007A29] text-xs font-bold uppercase tracking-wider mb-2 border border-[#007A29]/20">
                    @(sp.DanhMuc?.TenDanhMuc ?? "Dòng Sản Phẩm")
                </div>
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#222222] leading-tight uppercase tracking-tight">
                    @sp.TenSanPham
                </h1>
                <div class="w-16 h-1 bg-[#007A29] mt-3 mb-2"></div>
                <p class="text-xs text-[#666666] font-mono">Mã sản phẩm: TB-@sp.Id | Lượt xem: @(sp.LuotXem + 1) lần</p>

                <p class="text-sm text-[#555555] mt-4 leading-relaxed">
                    @sp.MoTaNgan
                </p>

                <!-- Technical Specs Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6">
                    <div class="bg-[#F8F9FA] border border-gray-200 rounded-xl p-3.5 text-center">
                        <span class="text-[11px] text-[#666666] uppercase font-semibold block">Nồng Độ Cồn</span>
                        <span class="text-lg font-black text-[#007A29] mt-0.5 block">@sp.NongDoCon% ABV</span>
                    </div>
                    <div class="bg-[#F8F9FA] border border-gray-200 rounded-xl p-3.5 text-center">
                        <span class="text-[11px] text-[#666666] uppercase font-semibold block">Dung Tích</span>
                        <span class="text-lg font-black text-[#222222] mt-0.5 block">@sp.DungTichMl ml</span>
                    </div>
                    <div class="bg-[#F8F9FA] border border-gray-200 rounded-xl p-3.5 text-center">
                        <span class="text-[11px] text-[#666666] uppercase font-semibold block">Xuất Xứ</span>
                        <span class="text-lg font-black text-[#222222] mt-0.5 block">@sp.XuatXu</span>
                    </div>
                    <div class="bg-[#F8F9FA] border border-gray-200 rounded-xl p-3.5 text-center">
                        <span class="text-[11px] text-[#666666] uppercase font-semibold block">Quy Cách</span>
                        <span class="text-xs font-bold text-[#444444] mt-1.5 block line-clamp-1">@sp.QuyCachDongGoi</span>
                    </div>
                </div>
            </div>

            <!-- CTA Actions -->
            <div class="pt-6 border-t border-gray-200 space-y-4">
                <div class="flex flex-wrap items-center gap-4">
                    <a href="/lien-he" class="flex-1 text-center py-3.5 px-6 rounded-full bg-[#007A29] hover:bg-[#006020] text-white font-bold text-xs uppercase tracking-wider shadow-md transition hover:scale-105">
                        <i class="fa-solid fa-handshake mr-2"></i> Liên Hệ Mua Đại Lý / Đặt Hàng
                    </a>
                    <a href="tel:0965156658" class="py-3.5 px-6 rounded-full bg-white hover:bg-gray-100 text-[#222222] font-bold text-xs border border-gray-300 transition shadow-sm">
                        <i class="fa-solid fa-phone mr-1.5 text-[#007A29]"></i> Hotline: 0965 156 658
                    </a>
                </div>
                <p class="text-[11px] text-[#666666] flex items-center gap-1.5">
                    <i class="fa-solid fa-truck-fast text-[#007A29]"></i> Hỗ trợ vận chuyển tận nơi cho nhà hàng, quán bar và đại lý phân phối trên toàn quốc.
                </p>
            </div>
        </div>
    </div>

    <!-- Video Embed or Detailed Content -->
    @if (!string.IsNullOrWhiteSpace(sp.VideoGioiThieuUrl))
    {
        <div class="mt-12 bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm">
            <h2 class="text-lg font-bold text-[#222222] mb-4 flex items-center gap-2 uppercase">
                <i class="fa-brands fa-youtube text-[#E31B23]"></i> Video Giới Thiệu
            </h2>
            <div class="aspect-video rounded-xl overflow-hidden border border-gray-200">
                <iframe src="@sp.VideoGioiThieuUrl" class="w-full h-full" frameborder="0" allowfullscreen></iframe>
            </div>
        </div>
    }

    <!-- Rich HTML Content -->
    @if (!string.IsNullOrWhiteSpace(sp.NoiDungChiTiet))
    {
        <div class="mt-12 bg-white border border-gray-200 rounded-2xl p-6 sm:p-10 shadow-sm">
            <h2 class="text-lg font-extrabold text-[#222222] mb-6 border-b border-gray-200 pb-4 flex items-center gap-2 uppercase">
                <i class="fa-solid fa-circle-info text-[#007A29]"></i> Thông Tin Chi Tiết & Hướng Dẫn Thưởng Thức
            </h2>
            <div class="prose max-w-none text-sm text-[#444444] leading-relaxed space-y-4">
                @Html.Raw(sp.NoiDungChiTiet)
            </div>
        </div>
    }

    <!-- Related Products -->
    @if (Model.SanPhamLienQuan.Any())
    {
        <div class="mt-16">
            <div class="flex items-end justify-between mb-8">
                <div>
                    <h2 class="text-xl sm:text-2xl font-extrabold text-[#222222] uppercase tracking-tight">Sản Phẩm Cùng Dòng</h2>
                    <div class="w-16 h-1 bg-[#007A29] mt-2"></div>
                </div>
                <a href="/san-pham" class="text-xs text-[#007A29] font-bold hover:underline inline-flex items-center gap-1">
                    Xem thêm <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var lq in Model.SanPhamLienQuan)
                {
                    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden group hover:border-[#007A29] transition-all duration-300 shadow-sm hover:shadow-md flex flex-col justify-between">
                        <a href="/san-pham/@lq.DuongDanSlug" class="block relative bg-white aspect-square p-6 flex items-center justify-center cursor-pointer group-hover:bg-gray-50/50 transition-colors border-b border-gray-100">
                            <img src="@lq.HinhAnhWebP" alt="@lq.TenSanPham" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" loading="lazy" />
                            <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2 py-0.5 rounded text-[10px] font-bold text-[#007A29] border border-gray-200 shadow-sm">
                                @lq.NongDoCon% ABV
                            </div>
                        </a>
                        <div class="p-4">
                            <h3 class="font-bold text-sm text-[#222222] line-clamp-1 group-hover:text-[#007A29] transition-colors">
                                <a href="/san-pham/@lq.DuongDanSlug">@lq.TenSanPham</a>
                            </h3>
                            <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-100">
                                <span class="text-xs text-[#666666]">@lq.DungTichMl ml</span>
                                <a href="/san-pham/@lq.DuongDanSlug" class="text-xs font-bold text-[#007A29] hover:underline">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>


@model ThaiBeer.ViewModels.DanhMucSanPhamViewModel
@{
    var title = Model.DanhMucHienTai != null ? Model.DanhMucHienTai.TenDanhMuc : "Tất Cả Sản Phẩm ThaiBeer";
    ViewData["Title"] = title;
    ViewData["Description"] = Model.DanhMucHienTai?.MoTa ?? "Danh mục đầy đủ các dòng bia chai, lon và bia tươi hoàng gia Thái Lan chính hãng.";
}

<div class="bg-thaicard border-b border-stone-800 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-stone-500 mb-4">
            <a href="/" class="hover:text-amber-400 transition">Trang Chủ</a>
            <span>/</span>
            <span class="text-stone-300">Sản Phẩm</span>
            @if (Model.DanhMucHienTai != null)
            {
                <span>/</span>
                <span class="text-amber-400 font-semibold">@Model.DanhMucHienTai.TenDanhMuc</span>
            }
        </nav>
        <h1 class="text-3xl sm:text-4xl font-black text-stone-100">@title</h1>
        <p class="text-xs sm:text-sm text-stone-400 mt-2 max-w-2xl">
            @(Model.DanhMucHienTai?.MoTa ?? "Khám phá bộ sưu tập bia Thái thượng hạng được sản xuất với tiêu chuẩn hoàng gia quốc tế.")
        </p>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Category Tabs -->
    <div class="flex items-center gap-3 overflow-x-auto pb-4 mb-10 border-b border-stone-800">
        <a href="/san-pham" class="px-5 py-2.5 rounded-xl text-xs font-bold whitespace-nowrap transition @(Model.DanhMucHienTai == null ? "bg-amber-500 text-stone-950 shadow-lg shadow-amber-500/20" : "bg-stone-900 text-stone-300 hover:bg-stone-800 hover:text-amber-400")">
            Tất Cả Sản Phẩm
        </a>
        @foreach (var dm in Model.TatCaDanhMuc)
        {
            var active = Model.DanhMucHienTai?.Id == dm.Id;
            <a href="/danh-muc/@dm.DuongDanSlug" class="px-5 py-2.5 rounded-xl text-xs font-bold whitespace-nowrap transition @(active ? "bg-amber-500 text-stone-950 shadow-lg shadow-amber-500/20" : "bg-stone-900 text-stone-300 hover:bg-stone-800 hover:text-amber-400")">
                @dm.TenDanhMuc
            </a>
        }
    </div>

    <!-- Product Grid -->
    @if (!Model.DanhSachSanPham.Any())
    {
        <div class="text-center py-20 bg-thaicard rounded-2xl border border-stone-800">
            <i class="fa-solid fa-beer-mug-empty text-4xl text-stone-600 mb-3"></i>
            <p class="text-sm font-semibold text-stone-400">Không có sản phẩm nào trong danh mục này.</p>
            <a href="/san-pham" class="inline-block mt-4 text-xs text-amber-400 font-bold hover:underline">Quay lại xem tất cả</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var sp in Model.DanhSachSanPham)
            {
                <div class="bg-thaicard border border-stone-800 rounded-2xl overflow-hidden group hover:border-amber-500/50 transition-all duration-300 hover:-translate-y-1.5 shadow-xl flex flex-col justify-between">
                    <!-- Khối ảnh có link điều hướng -->
                    <a href="/san-pham/@sp.DuongDanSlug" class="block relative bg-stone-900 aspect-square overflow-hidden p-4 flex items-center justify-center cursor-pointer group-hover:bg-stone-800/80 transition-colors">
                        <img src="@sp.HinhAnhWebP" alt="@sp.TenSanPham" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                        <div class="absolute top-3 left-3 bg-stone-950/80 backdrop-blur-md px-2.5 py-1 rounded-lg border border-amber-500/30 text-[11px] font-bold text-amber-400">
                            @sp.NongDoCon% ABV
                        </div>
                        <div class="absolute top-3 right-3 bg-stone-950/80 backdrop-blur-md px-2 py-1 rounded-lg border border-stone-800 text-[11px] font-medium text-stone-400">
                            @sp.DungTichMl ml
                        </div>
                    </a>

                    <div class="p-5 flex-1 flex flex-col justify-between">
                        <!-- Khối text (Danh mục, Tiêu đề, Mô tả) có link điều hướng -->
                        <a href="/san-pham/@sp.DuongDanSlug" class="block group/text cursor-pointer">
                            <span class="text-[11px] font-semibold text-amber-500 uppercase tracking-wider block mb-1">
                                @sp.DanhMuc?.TenDanhMuc
                            </span>
                            <h2 class="text-base font-bold text-stone-100 line-clamp-1 group-hover/text:text-amber-400 transition-colors">
                                @sp.TenSanPham
                            </h2>
                            <p class="text-xs text-stone-400 mt-2 line-clamp-2 leading-relaxed">
                                @sp.MoTaNgan
                            </p>
                        </a>

                        <div class="pt-4 mt-4 border-t border-stone-800/80 flex items-center justify-between">
                            <span class="text-xs text-stone-500">@sp.QuyCachDongGoi</span>
                            <a href="/san-pham/@sp.DuongDanSlug" class="px-3.5 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs transition">
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TongSoTrang > 1)
        {
            <div class="flex items-center justify-center gap-2 mt-12">
                @for (int i = 1; i <= Model.TongSoTrang; i++)
                {
                    var isCurrent = i == Model.TrangHienTai;
                    var url = Model.DanhMucHienTai != null
                        ? $"/danh-muc/{Model.DanhMucHienTai.DuongDanSlug}?trang={i}"
                        : $"/san-pham?trang={i}";

                    <a href="@url" class="w-10 h-10 rounded-xl flex items-center justify-center text-xs font-bold transition @(isCurrent ? "bg-amber-500 text-stone-950" : "bg-stone-900 text-stone-300 hover:bg-stone-800 hover:text-amber-400 border border-stone-800")">
                        @i
                    </a>
                }
            </div>
        }
    }
</div>

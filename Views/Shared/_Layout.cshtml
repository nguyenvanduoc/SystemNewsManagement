<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"] - ThaiBeer | Bia Hoàng Gia Thái Lan Thượng Hạng</title>
    <meta name="description" content="@(ViewData["Description"] ?? "ThaiBeer - Thương hiệu bia Thái hảo hạng, kế thừa công thức ủ men truyền thống kết hợp công nghệ hiện đại mang đến cảm giác sảng khoái bất tận.")" />
    <meta name="keywords" content="thaibeer, bia thái, bia chai thái lan, bia lon thái, bia hoàng gia, đại lý bia thái" />
    <meta property="og:title" content="@ViewData["Title"] - ThaiBeer" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Khám phá thế giới bia Thái đẳng cấp với ThaiBeer.")" />
    <meta property="og:type" content="website" />

    <!-- Google Fonts: Plus Jakarta Sans & Montserrat (Chuẩn thaibeer.vn) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <!-- Turbo Drive (Hotwired) - Chuyển trang mượt mà không chớp trắng -->
    <script src="https://cdn.jsdelivr.net/npm/@@hotwired/turbo@8.0.5/dist/turbo.es2017-umd.js" defer></script>


    <!-- Swiper Slider CSS & JS - 60fps Mobile Swipe Touch -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

   
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        hnkgreen: '#007A29',
                        hnkdeep: '#003110',
                        hnkred: '#E31B23',
                        hnkbody: '#F4F4F4',
                        hnksub: '#E5E8E7',
                        hnkfooter: '#E0E2E1',
                        hnktext: '#222222',
                        hnkmuted: '#666666',
                        // Compatibility aliases
                        thaigold: '#007A29',
                        thaiamber: '#007A29',
                        thaidark: '#FFFFFF',
                        thaicard: '#FFFFFF',
                        thaimuted: '#F4F4F4'
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        /* Turbo progress bar styling */
        .turbo-progress-bar {
            height: 3px;
            background: #007A29;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #F4F4F4; }
        ::-webkit-scrollbar-thumb { background: #D1D5DB; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #007A29; }

        /* Mobile Drag Scrollbar (Thanh kéo trái) */
        .category-swiper, .product-swiper, .process-swiper, .news-swiper {
            width: 100%;
            overflow: hidden;
            position: relative;
        }
        .category-swiper .swiper-slide, .product-swiper .swiper-slide, .process-swiper .swiper-slide, .news-swiper .swiper-slide {
            width: 100% !important;
            box-sizing: border-box;
        }
        .category-scrollbar, .product-scrollbar, .process-scrollbar, .news-scrollbar {
            height: 6px !important;
            background: #E5E7EB !important;
            border-radius: 9999px !important;
            position: relative !important;
            margin-top: 1.25rem !important;
            width: 100% !important;
        }
        .category-scrollbar .swiper-scrollbar-drag, .product-scrollbar .swiper-scrollbar-drag, .process-scrollbar .swiper-scrollbar-drag, .news-scrollbar .swiper-scrollbar-drag {
            background: #007A29 !important;
            border-radius: 9999px !important;
            height: 100% !important;
            cursor: grab;
        }
        .product-scrollbar .swiper-scrollbar-drag, .process-scrollbar .swiper-scrollbar-drag {
            background: #B91C1C !important;
        }
        .news-scrollbar .swiper-scrollbar-drag {
            background: #007A29 !important;
        }
        .category-scrollbar .swiper-scrollbar-drag:active, .product-scrollbar .swiper-scrollbar-drag:active, .process-scrollbar .swiper-scrollbar-drag:active, .news-scrollbar .swiper-scrollbar-drag:active {
            cursor: grabbing;
        }

        /* Hiệu ứng gợn sóng bắt mắt cho nút Liên Hệ nổi */
        @@keyframes contactPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(179, 13, 20, 0.7);
            }
            70% {
                box-shadow: 0 0 0 14px rgba(179, 13, 20, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(179, 13, 20, 0);
            }
        }
        .contact-pulse-btn {
            animation: contactPulse 2.2s infinite;
        }
    </style>
</head>
<body class="bg-[#F4F4F4] text-[#222222] font-sans antialiased selection:bg-[#007A29] selection:text-white flex flex-col min-h-screen">

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-50 shadow-sm transition-all duration-300">
        <!-- Desktop Header (Clean White Style) -->
        <div class="hidden lg:block bg-white border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between">
                <!-- Brand Logo (Chuẩn ThaiBeer.vn to rõ nét) -->
                <a href="/" class="flex items-center group py-1" title="ThaiBeer">
                    <img src="~/images/logo/logo-1782459965.webp.webp" asp-append-version="true" alt="ThaiBeer Logo" width="85" height="100" class="h-20 lg:h-[84px] w-auto object-contain transition-transform duration-300 group-hover:scale-105 rounded-md shadow-sm" />
                </a>

                <!-- Desktop Navigation Links -->
                <nav class="flex items-center text-[15px] font-bold text-[#222222]">
                    <a href="/" class="px-4 xl:px-5 py-2 hover:text-[#B30D14] transition-colors">Trang Chủ</a>
                    <span class="text-gray-300 select-none">|</span>
                    <a href="/san-pham" class="px-4 xl:px-5 py-2 hover:text-[#B30D14] transition-colors">Bộ Sưu Tập Sản Phẩm</a>
                    <span class="text-gray-300 select-none">|</span>
                    <a href="/tin-tuc" class="px-4 xl:px-5 py-2 hover:text-[#B30D14] transition-colors">Văn Hóa & Tin Tức</a>
                    <span class="text-gray-300 select-none">|</span>
                    <a href="/#quy-trinh-san-xuat" class="px-4 xl:px-5 py-2 hover:text-[#B30D14] transition-colors">Quy Trình Sản Xuất</a>
                </nav>

                <!-- Call to Action & Hotline Pill -->
                <div class="flex items-center gap-3">
                    <a href="tel:0965156658" class="flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#B30D14] bg-[#FFF5F5] text-xs text-[#222222] hover:bg-[#B30D14] hover:text-white transition group shadow-sm">
                        <span class="w-6 h-6 rounded-full bg-[#B30D14] text-white flex items-center justify-center group-hover:bg-white group-hover:text-[#B30D14] transition">
                            <i class="fa-solid fa-phone text-[10px]"></i>
                        </span>
                        <div class="text-left">
                            <span class="block text-[9px] text-[#666666] uppercase tracking-wider group-hover:text-white/80 leading-tight">Hotline</span>
                            <span class="font-bold text-[#B30D14] group-hover:text-white text-xs leading-none">0965 156 658</span>
                        </div>
                    </a>
                    <a href="/lien-he" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#B30D14] hover:bg-[#8E090F] text-white font-bold text-xs uppercase tracking-wider shadow-sm transition-all hover:scale-105">
                        <span>Đăng Ký Đại Lý</span>
                        <span class="w-4 h-4 rounded-full bg-white/20 flex items-center justify-center text-[10px]">→</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Mobile Header (Chuẩn 100% ThaiBeer.vn: Nền Đỏ Hoàng Gia #900C13, Hamburger Trắng, Logo To Giữa, Kính Lúp Vàng) -->
        <div class="lg:hidden bg-[#900C13] border-b border-[#73090F] shadow-md">
            <div class="px-4 h-20 flex items-center justify-between relative">
                <!-- Hamburger Menu Bên Trái -->
                <button id="mobileMenuBtn" type="button" class="w-10 h-10 flex items-center justify-center text-white active:scale-95 transition" aria-label="Menu điều hướng">
                    <i class="fa-solid fa-bars text-2xl"></i>
                </button>

                <!-- Logo ThaiBeer Con Voi Nằm Chính Giữa To Rõ Nét Giống thaibeer.vn -->
                <a href="/" class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center py-1">
                    <img src="~/images/logo/logo-1782459965.webp.webp" asp-append-version="true" alt="ThaiBeer Logo" width="85" height="100" class="h-16 w-auto object-contain rounded-md shadow-sm" />
                </a>

                <!-- Nút Tìm Kiếm Tròn Màu Vàng Bên Phải -->
                <button id="mobileSearchToggleBtn" type="button" class="w-10 h-10 rounded-full bg-[#F5B400] hover:bg-[#E0A400] active:scale-95 text-white flex items-center justify-center shadow-md transition" aria-label="Mở tìm kiếm">
                    <i class="fa-solid fa-magnifying-glass text-lg"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Search Dropdown Bar (Hiển thị khi click nút kính lúp vàng) -->
        <div id="mobileSearchBar" class="hidden lg:hidden bg-white border-b border-gray-200 px-4 py-3.5 shadow-md">
            <form action="/san-pham" method="get" class="flex items-center gap-2">
                <div class="relative flex-1">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input type="text" id="mobileSearchInput" name="tuKhoa" placeholder="Tìm kiếm sản phẩm bia Thai..." class="w-full bg-gray-100 border border-gray-300 rounded-full pl-10 pr-4 py-2 text-xs text-gray-800 focus:outline-none focus:border-[#900C13] focus:bg-white transition" />
                </div>
                <button type="submit" class="px-4 py-2 rounded-full bg-[#900C13] hover:bg-[#73090F] text-white text-xs font-bold shadow transition">
                    Tìm
                </button>
            </form>
        </div>

        <!-- Mobile Drawer Menu (Slide Down) -->
        <div id="mobileDrawer" class="hidden lg:hidden bg-white border-b border-gray-200 px-6 py-6 space-y-3 shadow-lg">
            <a href="/" class="block text-base font-bold text-[#222222] hover:text-[#900C13] py-2 border-b border-gray-100">Trang Chủ</a>
            <a href="/san-pham" class="block text-base font-bold text-[#222222] hover:text-[#900C13] py-2 border-b border-gray-100">Bộ Sưu Tập Sản Phẩm</a>
            <a href="/tin-tuc" class="block text-base font-bold text-[#222222] hover:text-[#900C13] py-2 border-b border-gray-100">Văn Hóa & Tin Tức</a>
            <a href="/#quy-trinh-san-xuat" class="block text-base font-bold text-[#222222] hover:text-[#900C13] py-2 border-b border-gray-100">Quy Trình Sản Xuất</a>
            <div class="pt-4 flex flex-col gap-3">
                <a href="/lien-he" class="w-full text-center py-3 rounded-full bg-[#900C13] hover:bg-[#73090F] text-white font-bold text-sm shadow">
                    Đăng Ký Đại Lý Phân Phối
                </a>
                <a href="tel:0965156658" class="w-full text-center py-2.5 rounded-full bg-gray-100 text-[#900C13] text-xs font-bold border border-gray-200">
                    <i class="fa-solid fa-phone mr-1.5"></i> Hotline: 0965 156 658
                </a>
                <a href="/quan-tri" class="w-full text-center py-2 rounded-lg text-gray-500 text-xs">
                    <i class="fa-solid fa-lock mr-1"></i> Cổng Quản Trị Hệ Thống
                </a>
            </div>
        </div>
    </header>

    <!-- Main Dynamic Body -->
    <main id="main-content" class="flex-1">
        @RenderBody()
    </main>

    <!-- Footer (Chuẩn ThaiBeer.vn: Nền tối sang trọng #212121, Logo ThaiBeer to 85x100 kèm Text THAI BEER) -->
    <footer class="bg-[#212121] border-t border-[#333333] pt-14 pb-10 mt-16 text-[#B0B0B0] text-sm font-['Montserrat',sans-serif]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-[#333333]">
                <!-- Column 1: Brand Info & Logo ThaiBeer To (Như ảnh mẫu từ thaibeer.vn) -->
                <div class="lg:col-span-2 space-y-4">
                    <div class="name-logo flex items-center gap-4">
                        <div class="footer__logo">
                            <a href="/" class="block group">
                                <img src="~/images/logo/logo-1782459965.webp.webp" asp-append-version="true" alt="ThaiBeer Logo" width="85" height="100" class="w-[85px] h-[100px] object-contain rounded-md shadow-md transition-transform duration-300 group-hover:scale-105" />
                            </a>
                        </div>
                        <h2 class="name-company text-3xl sm:text-4xl font-black text-white uppercase tracking-wider">THAI BEER</h2>
                    </div>
                    <p class="text-xs text-[#AAAAAA] leading-relaxed pr-6">
                        Với đội ngũ cán bộ, công nhân viên có trình độ tay nghề cao, các thiết bị máy móc hiện đại, đã cập nhật các kiến thức mới nhằm mang đến trải nghiệm bia thượng hạng cho người tiêu dùng Việt Nam.
                    </p>
                    <div class="flex items-center gap-3 pt-1">
                        <span class="w-9 h-9 rounded-full bg-[#2E2E2E] border border-[#444444] flex items-center justify-center text-white hover:text-[#FFBA1D] hover:border-[#FFBA1D] transition cursor-pointer shadow-sm">
                            <i class="fa-brands fa-facebook-f text-sm"></i>
                        </span>
                        <span class="w-9 h-9 rounded-full bg-[#2E2E2E] border border-[#444444] flex items-center justify-center text-white hover:text-[#FFBA1D] hover:border-[#FFBA1D] transition cursor-pointer shadow-sm">
                            <i class="fa-brands fa-youtube text-sm"></i>
                        </span>
                        <span class="w-9 h-9 rounded-full bg-[#2E2E2E] border border-[#444444] flex items-center justify-center text-white hover:text-[#FFBA1D] hover:border-[#FFBA1D] transition cursor-pointer shadow-sm">
                            <i class="fa-brands fa-tiktok text-sm"></i>
                        </span>
                    </div>
                </div>

                <!-- Column 2: Quick Links -->
                <div>
                    <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4 border-l-4 border-[#B30D14] pl-2.5">Sản Phẩm</h4>
                    <ul class="space-y-2.5 text-xs text-[#B0B0B0]">
                        <li><a href="/danh-muc/bia-chai-thai" class="hover:text-[#FFBA1D] transition">Bia Chai Cao Cấp</a></li>
                        <li><a href="/danh-muc/bia-lon-thai" class="hover:text-[#FFBA1D] transition">Bia Lon Tiện Lợi</a></li>
                        <li><a href="/danh-muc/bia-tuoi-craft" class="hover:text-[#FFBA1D] transition">Bia Tươi & Craft Thủ Công</a></li>
                        <li><a href="/danh-muc/hop-qua-phu-kien" class="hover:text-[#FFBA1D] transition">Hộp Quà & Phụ Kiện</a></li>
                    </ul>
                </div>

                <!-- Column 3: Corporate -->
                <div>
                    <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4 border-l-4 border-[#B30D14] pl-2.5">Về Chúng Tôi</h4>
                    <ul class="space-y-2.5 text-xs text-[#B0B0B0]">
                        <li><a href="/tin-tuc" class="hover:text-[#FFBA1D] transition">Chặng Đường Phát Triển</a></li>
                        <li><a href="/#quy-trinh-san-xuat" class="hover:text-[#FFBA1D] transition">Quy Trình Nấu Men & Sản Xuất</a></li>
                        <li><a href="/lien-he" class="hover:text-[#FFBA1D] transition">Phát Triển Bền Vững</a></li>
                        <li><a href="/lien-he" class="hover:text-[#FFBA1D] transition">Chính Sách Nhà Phân Phối</a></li>
                    </ul>
                </div>

                <!-- Column 4: Contact & Hotlines -->
                <div>
                    <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4 border-l-4 border-[#B30D14] pl-2.5">Hỗ Trợ & Liên Hệ</h4>
                    <ul class="space-y-3 text-xs text-[#B0B0B0]">
                        <li class="flex items-start gap-2.5">
                            <i class="fa-solid fa-location-dot text-[#FFBA1D] mt-1"></i>
                            <span>Văn phòng đại diện: Tòa nhà Bitexco, Q.1, TP. Hồ Chí Minh</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <i class="fa-solid fa-phone text-[#FFBA1D]"></i>
                            <a href="tel:0965156658" class="text-white font-bold hover:text-[#FFBA1D] transition">0965 156 658</a>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <i class="fa-solid fa-envelope text-[#FFBA1D]"></i>
                            <a href="mailto:nhuttrongchau@gmail.com" class="hover:text-[#FFBA1D] transition">nhuttrongchau@gmail.com</a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Bottom Copyright & Legal -->
            <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#777777]">
                <p>© @DateTime.Now.Year ThaiBeer Vietnam. Uống có trách nhiệm. Vận hành ổn định trên nền tảng Windows IIS HOSTVN.</p>
                <div class="flex items-center gap-4">
                    <a href="#" class="hover:text-[#FFBA1D] transition">Điều khoản & Điều kiện</a>
                    <span>•</span>
                    <a href="#" class="hover:text-[#FFBA1D] transition">Quyền riêng tư</a>
                    <span>•</span>
                    <a href="/quan-tri" class="hover:text-[#FFBA1D] transition flex items-center gap-1">
                        <i class="fa-solid fa-lock text-[10px]"></i> Quản Trị
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Widget Nổi Liên Hệ & Gọi Điện / Zalo Đa Kênh (Chuẩn 100% Theo Ảnh Mẫu) -->
    <div id="contactWidgetContainer" class="fixed bottom-6 right-6 z-50 flex flex-col items-end pointer-events-auto select-none">
        <!-- Hộp Popup Tùy Chọn Liên Hệ (Ẩn theo mặc định, click nút tròn đỏ để mở) -->
        <div id="contactPopupBox" class="hidden mb-3 w-[290px] sm:w-[320px] bg-white rounded-2xl shadow-2xl overflow-hidden border border-gray-100 transition-all duration-300 transform origin-bottom-right scale-95 opacity-0">
            <!-- Header Màu Đỏ Hoàng Gia -->
            <div class="bg-[#900C13] px-4 py-3 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-headset text-white text-sm"></i>
                    <h4 class="text-white font-bold text-sm tracking-wide">Liên hệ với chúng tôi</h4>
                </div>
                <button type="button" id="closeContactPopupBtn" class="text-white/80 hover:text-white transition w-6 h-6 flex items-center justify-center text-sm rounded-full hover:bg-white/10" aria-label="Đóng popup">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Danh Sách Lựa Chọn: Hotline, Zalo, Messenger, Địa Chỉ -->
            <div class="p-3 divide-y divide-gray-100 space-y-1 bg-white">
                <!-- 1. Hotline / Gọi Điện Trực Tiếp -->
                <a href="tel:0965156658" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-gray-50 transition group">
                    <div class="w-10 h-10 rounded-full bg-[#22C55E] flex items-center justify-center text-white text-base shadow-sm shrink-0 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-phone"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <span class="text-xs font-bold text-[#111111] block group-hover:text-[#22C55E] transition-colors">Hotline:</span>
                        <span class="text-xs text-[#555555] font-semibold">0965 156 658</span>
                    </div>
                    <i class="fa-solid fa-chevron-right text-gray-300 text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                </a>

                <!-- 2. Zalo Chat -->
                <a href="https://zalo.me/0965156658" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-gray-50 transition group">
                    <div class="w-10 h-10 rounded-full bg-[#0068FF] flex items-center justify-center text-white text-[11px] font-black shadow-sm shrink-0 tracking-tighter group-hover:scale-110 transition-transform">
                        Zalo
                    </div>
                    <div class="flex-1 min-w-0">
                        <span class="text-xs font-bold text-[#111111] block group-hover:text-[#0068FF] transition-colors">Zalo chat:</span>
                        <span class="text-xs text-[#555555] truncate block">Tài khoản Zalo: 0965 156 658</span>
                    </div>
                    <i class="fa-solid fa-chevron-right text-gray-300 text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                </a>

                <!-- 3. Messenger Chat -->
                <a href="https://m.me/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-gray-50 transition group">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-[#006AFF] to-[#00C6FF] flex items-center justify-center text-white text-base shadow-sm shrink-0 group-hover:scale-110 transition-transform">
                        <i class="fa-brands fa-facebook-messenger"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <span class="text-xs font-bold text-[#111111] block group-hover:text-[#006AFF] transition-colors">Messenger:</span>
                        <span class="text-xs text-[#555555] truncate block">Công Ty CP Bia Sài Gòn Cửu Long</span>
                    </div>
                    <i class="fa-solid fa-chevron-right text-gray-300 text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                </a>

                <!-- 4. Xem Địa Chỉ Văn Phòng & Đăng Ký Đại Lý -->
                <a href="/lien-he" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-gray-50 transition group">
                    <div class="w-10 h-10 rounded-full bg-[#D9383A] flex items-center justify-center text-white text-base shadow-sm shrink-0 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <span class="text-xs font-bold text-[#111111] block group-hover:text-[#D9383A] transition-colors">Địa chỉ:</span>
                        <span class="text-xs text-[#555555] block">Xem địa chỉ</span>
                    </div>
                    <i class="fa-solid fa-chevron-right text-gray-300 text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                </a>
            </div>
        </div>

        <!-- Nút Tròn Đỏ Nổi 'Liên Hệ' (Có hiệu ứng gợn sóng bắt mắt) -->
        <button type="button" 
                id="toggleContactWidgetBtn" 
                class="contact-pulse-btn w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#B30D14] hover:bg-[#900C13] active:scale-95 text-white flex flex-col items-center justify-center shadow-2xl border-2 border-white transition-all duration-300 cursor-pointer"
                title="Liên hệ tư vấn">
            <i class="fa-solid fa-comments text-lg sm:text-xl leading-none"></i>
            <span class="text-[10px] sm:text-[11px] font-bold leading-tight mt-0.5">Liên hệ</span>
        </button>
    </div>

    <!-- Global Client Scripts: Turbo Reconnect & Swiper Initialization -->
    <script>
        function initializeThaiBeerUI() {
            if (typeof Swiper === "undefined") {
                setTimeout(initializeThaiBeerUI, 50);
                return;
            }

            // 0. Tự động phát Video Banner Introbeer (nếu có)
            const videoBanner = document.getElementById("videoId");
            if (videoBanner) {
                videoBanner.muted = true;
                videoBanner.play().catch(function(e) {
                    console.log("Video autoplay prevented:", e);
                });
            }

            // 1. Khởi tạo lại Swiper Hero Banner
            if (document.querySelector(".hero-swiper")) {
                new Swiper(".hero-swiper", {
                    loop: true,
                    speed: 800,
                    autoplay: {
                        delay: 5000,
                        disableOnInteraction: false,
                    },
                    pagination: {
                        el: ".swiper-pagination",
                        clickable: true,
                    },
                    effect: "fade",
                    fadeEffect: { crossFade: true }
                });
            }

            // 2. Khởi tạo Swiper Bộ sưu tập trên Mobile (Chỉ 1 card, có thanh kéo trái draggable)
            if (document.querySelector(".category-swiper")) {
                const catSwiper = new Swiper(".category-swiper", {
                    slidesPerView: 1,
                    spaceBetween: 16,
                    grabCursor: true,
                    scrollbar: {
                        el: ".category-scrollbar",
                        draggable: true,
                        dragSize: 70,
                        hide: false,
                    },
                    on: {
                        slideChange: function() {
                            const counter = document.getElementById("categorySlideCounter");
                            if (counter) {
                                counter.textContent = `${this.activeIndex + 1} / ${this.slides.length}`;
                            }
                        }
                    }
                });
            }

            // 3. Khởi tạo Swiper Sản phẩm nổi bật trên Mobile (Chỉ 1 card, có thanh kéo trái draggable)
            if (document.querySelector(".product-swiper")) {
                const prodSwiper = new Swiper(".product-swiper", {
                    slidesPerView: 1,
                    spaceBetween: 16,
                    grabCursor: true,
                    scrollbar: {
                        el: ".product-scrollbar",
                        draggable: true,
                        dragSize: 70,
                        hide: false,
                    },
                    on: {
                        slideChange: function() {
                            const counter = document.getElementById("productSlideCounter");
                            if (counter) {
                                counter.textContent = `${this.activeIndex + 1} / ${this.slides.length}`;
                            }
                        }
                    }
                });
            }

            // 4. Khởi tạo Swiper Quy Trình Sản Xuất trên Mobile (Chỉ 1 card, có thanh kéo trái draggable)
            if (document.querySelector(".process-swiper")) {
                const procSwiper = new Swiper(".process-swiper", {
                    slidesPerView: 1,
                    spaceBetween: 16,
                    grabCursor: true,
                    scrollbar: {
                        el: ".process-scrollbar",
                        draggable: true,
                        dragSize: 70,
                        hide: false,
                    },
                    on: {
                        slideChange: function() {
                            const counter = document.getElementById("processSlideCounter");
                            if (counter) {
                                counter.textContent = `${this.activeIndex + 1} / ${this.slides.length}`;
                            }
                        }
                    }
                });
            }

            // 5. Khởi tạo Swiper Tin Tức & Sự Kiện trên Mobile (Chỉ 1 card, có thanh kéo trái draggable)
            if (document.querySelector(".news-swiper")) {
                const newsSwiper = new Swiper(".news-swiper", {
                    slidesPerView: 1,
                    spaceBetween: 16,
                    grabCursor: true,
                    scrollbar: {
                        el: ".news-scrollbar",
                        draggable: true,
                        dragSize: 70,
                        hide: false,
                    },
                    on: {
                        slideChange: function() {
                            const counter = document.getElementById("newsSlideCounter");
                            if (counter) {
                                counter.textContent = `${this.activeIndex + 1} / ${this.slides.length}`;
                            }
                        }
                    }
                });
            }

            // 5. Xử lý nút Mobile Menu & Mobile Search
            const btn = document.getElementById("mobileMenuBtn");
            const drawer = document.getElementById("mobileDrawer");
            if (btn && drawer) {
                btn.onclick = function() {
                    drawer.classList.toggle("hidden");
                    const searchBar = document.getElementById("mobileSearchBar");
                    if (searchBar) searchBar.classList.add("hidden");
                };
            }

            // 6. Xử lý click chuyển đến #quy-trinh-san-xuat mượt mà
            document.querySelectorAll('a[href*="#quy-trinh-san-xuat"]').forEach(function(anchor) {
                anchor.onclick = function(e) {
                    if (window.location.pathname === '/' || window.location.pathname === '') {
                        const target = document.getElementById('quy-trinh-san-xuat');
                        if (target) {
                            e.preventDefault();
                            target.scrollIntoView({ behavior: 'smooth' });
                            if (drawer && !drawer.classList.contains("hidden")) {
                                drawer.classList.add("hidden");
                            }
                        }
                    }
                };
            });

            const searchBtn = document.getElementById("mobileSearchToggleBtn");
            const searchBar = document.getElementById("mobileSearchBar");
            const searchInput = document.getElementById("mobileSearchInput");
            if (searchBtn && searchBar) {
                searchBtn.onclick = function() {
                    searchBar.classList.toggle("hidden");
                    if (drawer) drawer.classList.add("hidden");
                    if (!searchBar.classList.contains("hidden") && searchInput) {
                        setTimeout(function() { searchInput.focus(); }, 100);
                    }
                };
            }

            // 7. Xử lý popup Liên Hệ nổi (Đa kênh: Hotline, Zalo, Messenger, Địa chỉ)
            const toggleContactBtn = document.getElementById("toggleContactWidgetBtn");
            const contactPopup = document.getElementById("contactPopupBox");
            const closeContactBtn = document.getElementById("closeContactPopupBtn");

            if (toggleContactBtn && contactPopup) {
                toggleContactBtn.onclick = function(e) {
                    e.stopPropagation();
                    const isHidden = contactPopup.classList.contains("hidden");
                    if (isHidden) {
                        contactPopup.classList.remove("hidden");
                        requestAnimationFrame(function() {
                            contactPopup.classList.remove("scale-95", "opacity-0");
                            contactPopup.classList.add("scale-100", "opacity-100");
                        });
                    } else {
                        contactPopup.classList.remove("scale-100", "opacity-100");
                        contactPopup.classList.add("scale-95", "opacity-0");
                        setTimeout(function() { contactPopup.classList.add("hidden"); }, 200);
                    }
                };

                if (closeContactBtn) {
                    closeContactBtn.onclick = function(e) {
                        e.stopPropagation();
                        contactPopup.classList.remove("scale-100", "opacity-100");
                        contactPopup.classList.add("scale-95", "opacity-0");
                        setTimeout(function() { contactPopup.classList.add("hidden"); }, 200);
                    };
                }

                // Đóng popup khi click ra ngoài
                document.addEventListener("click", function(e) {
                    if (contactPopup && !contactPopup.classList.contains("hidden")) {
                        if (!contactPopup.contains(e.target) && !toggleContactBtn.contains(e.target)) {
                            contactPopup.classList.remove("scale-100", "opacity-100");
                            contactPopup.classList.add("scale-95", "opacity-0");
                            setTimeout(function() { contactPopup.classList.add("hidden"); }, 200);
                        }
                    }
                });
            }

            // 8. Tự động chạy số (Count-up Animation) cho các con số thống kê trong 2 - 3 giây khi cuộn tới
            const statCounters = document.querySelectorAll(".stat-counter");
            if (statCounters.length > 0) {
                if ("IntersectionObserver" in window) {
                    const counterObserver = new IntersectionObserver(function(entries, observer) {
                        entries.forEach(function(entry) {
                            if (entry.isIntersecting) {
                                runCounterAnimation(entry.target);
                                observer.unobserve(entry.target);
                            }
                        });
                    }, { threshold: 0.2 });

                    statCounters.forEach(function(el) {
                        const suffix = el.getAttribute("data-suffix") || "";
                        el.textContent = "0" + suffix;
                        counterObserver.observe(el);
                    });
                } else {
                    statCounters.forEach(function(el) {
                        runCounterAnimation(el);
                    });
                }

                function runCounterAnimation(el) {
                    const target = parseInt(el.getAttribute("data-target"), 10) || 0;
                    const suffix = el.getAttribute("data-suffix") || "";
                    const useDot = el.getAttribute("data-dot") === "true";
                    const duration = 2300; // Thời gian chạy số 2.3 giây (trong khoảng 2-3 giây theo yêu cầu)
                    let startTime = null;

                    function animationStep(timestamp) {
                        if (!startTime) startTime = timestamp;
                        const elapsed = timestamp - startTime;
                        const progress = Math.min(elapsed / duration, 1);

                        // Easing out cubic: mượt mà, ban đầu chạy nhanh rồi giảm tốc êm ái
                        const ease = 1 - Math.pow(1 - progress, 3);
                        const current = Math.floor(ease * target);

                        let formatted = current.toString();
                        if (useDot) {
                            formatted = current.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                        }

                        el.textContent = formatted + suffix;

                        if (progress < 1) {
                            requestAnimationFrame(animationStep);
                        } else {
                            let finalVal = target.toString();
                            if (useDot) {
                                finalVal = target.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                            }
                            el.textContent = finalVal + suffix;
                        }
                    }

                    requestAnimationFrame(animationStep);
                }
            }
        }

        // Kích hoạt khi trang tải lần đầu hoặc khi Turbo Drive điều hướng trang thành công
        document.addEventListener("turbo:load", initializeThaiBeerUI);
        document.addEventListener("DOMContentLoaded", initializeThaiBeerUI);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

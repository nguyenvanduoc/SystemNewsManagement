@model ThaiBeer.Core.Domain.Entities.BaiViet
@{
    ViewData["Title"] = Model.TieuDe;
    ViewData["Description"] = Model.TomTat ?? Model.TieuDe;
    var tinLienQuan = (List<ThaiBeer.Core.Domain.Entities.BaiViet>?)ViewBag.TinLienQuan;
}

<div class="bg-[#E5E8E7] border-b border-gray-300 py-4">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-[#666666]">
            <a href="/" class="hover:text-[#007A29] transition">Trang Chủ</a>
            <span>/</span>
            <a href="/tin-tuc" class="hover:text-[#007A29] transition">Tin Tức</a>
            <span>/</span>
            <span class="text-[#007A29] font-bold truncate">@Model.TieuDe</span>
        </nav>
    </div>
</div>

<article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-10 shadow-sm">
        <header class="space-y-4 mb-8">
            <span class="inline-block px-3 py-1 rounded-full bg-[#007A29]/10 text-[#007A29] text-xs font-bold uppercase tracking-wider border border-[#007A29]/20">
                Thông Cáo Báo Chí & Tin Tức
            </span>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#222222] leading-tight">
                @Model.TieuDe
            </h1>
            <div class="w-16 h-1 bg-[#007A29] mt-3"></div>
            <div class="flex items-center gap-4 text-xs text-[#666666] font-mono pt-3 border-t border-gray-100">
                <span><i class="fa-regular fa-user mr-1"></i> Tác giả: @Model.TacGia</span>
                <span>•</span>
                <span><i class="fa-regular fa-calendar mr-1"></i> @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</span>
                <span>•</span>
                <span><i class="fa-regular fa-eye mr-1"></i> @Model.LuotXem lượt đọc</span>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.HinhAnhWebP))
        {
            <div class="rounded-xl overflow-hidden mb-8 border border-gray-200 shadow-sm">
                <img src="@Model.HinhAnhWebP" alt="@Model.TieuDe" class="w-full max-h-[500px] object-cover" />
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.TomTat))
        {
            <div class="p-6 rounded-xl bg-[#F8F9FA] border-l-4 border-[#007A29] mb-8 text-sm sm:text-base font-semibold text-[#333333] leading-relaxed italic">
                @Model.TomTat
            </div>
        }

        <div class="prose max-w-none text-[#333333] text-sm sm:text-base leading-relaxed space-y-5">
            @Html.Raw(Model.NoiDungHtml)
        </div>

        <!-- Share & Footer -->
        <div class="mt-12 pt-8 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4">
            <a href="/tin-tuc" class="text-xs text-[#007A29] font-bold hover:underline inline-flex items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách bài viết
            </a>
            <div class="flex items-center gap-3 text-xs text-[#666666]">
                <span>Chia sẻ:</span>
                <button class="w-8 h-8 rounded-full bg-gray-100 text-[#444444] hover:bg-[#007A29] hover:text-white flex items-center justify-center transition shadow-sm">
                    <i class="fa-brands fa-facebook-f text-xs"></i>
                </button>
                <button class="w-8 h-8 rounded-full bg-gray-100 text-[#444444] hover:bg-[#007A29] hover:text-white flex items-center justify-center transition shadow-sm">
                    <i class="fa-brands fa-linkedin-in text-xs"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Related Articles -->
    @if (tinLienQuan != null && tinLienQuan.Any())
    {
        <div class="mt-12 pt-8 border-t border-gray-200">
            <div class="mb-6">
                <h2 class="text-xl font-extrabold text-[#222222] uppercase tracking-tight">Tin Tức Liên Quan</h2>
                <div class="w-16 h-1 bg-[#007A29] mt-2"></div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                @foreach (var r in tinLienQuan)
                {
                    <a href="/tin-tuc/@r.DuongDanSlug" class="group bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-[#007A29] transition shadow-sm hover:shadow-md">
                        <img src="@r.HinhAnhWebP" alt="@r.TieuDe" class="w-full h-36 object-cover" loading="lazy" />
                        <div class="p-4">
                            <h3 class="text-xs font-bold text-[#222222] line-clamp-2 group-hover:text-[#007A29] transition-colors leading-snug">
                                @r.TieuDe
                            </h3>
                            <span class="text-[10px] text-[#666666] font-mono mt-2 block">@r.NgayTao.ToString("dd/MM/yyyy")</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</article>


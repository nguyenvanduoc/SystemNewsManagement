@model ThaiBeer.Core.Domain.Entities.BaiViet
@{
    ViewData["Title"] = Model.TieuDe;
    ViewData["Description"] = Model.TomTat ?? Model.TieuDe;
    var tinLienQuan = (List<ThaiBeer.Core.Domain.Entities.BaiViet>?)ViewBag.TinLienQuan;
}

<div class="bg-thaicard border-b border-stone-800 py-6">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-stone-500">
            <a href="/" class="hover:text-amber-400 transition">Trang Chủ</a>
            <span>/</span>
            <a href="/tin-tuc" class="hover:text-amber-400 transition">Tin Tức</a>
            <span>/</span>
            <span class="text-amber-400 font-semibold truncate">@Model.TieuDe</span>
        </nav>
    </div>
</div>

<article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="space-y-4 mb-8">
        <span class="inline-block px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 text-xs font-bold uppercase tracking-wider border border-amber-500/20">
            Văn Hóa Ẩm Thực & Men Bia
        </span>
        <h1 class="text-2xl sm:text-4xl font-black text-stone-100 leading-tight">
            @Model.TieuDe
        </h1>
        <div class="flex items-center gap-4 text-xs text-stone-400 font-mono pt-2 border-t border-stone-800">
            <span>Tác giả: @Model.TacGia</span>
            <span>•</span>
            <span>Ngày đăng: @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</span>
            <span>•</span>
            <span>Lượt đọc: @Model.LuotXem</span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.HinhAnhWebP))
    {
        <div class="rounded-3xl overflow-hidden mb-8 border border-stone-800 shadow-2xl">
            <img src="@Model.HinhAnhWebP" alt="@Model.TieuDe" class="w-full max-h-[500px] object-cover" />
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.TomTat))
    {
        <div class="p-6 rounded-2xl bg-thaicard border-l-4 border-amber-500 mb-8 text-sm sm:text-base font-semibold text-stone-200 leading-relaxed italic">
            @Model.TomTat
        </div>
    }

    <div class="prose prose-invert prose-amber max-w-none text-stone-300 text-sm sm:text-base leading-relaxed space-y-5">
        @Html.Raw(Model.NoiDungHtml)
    </div>

    <!-- Share & Footer -->
    <div class="mt-12 pt-8 border-t border-stone-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/tin-tuc" class="text-xs text-amber-400 font-bold hover:underline flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách bài viết
        </a>
        <div class="flex items-center gap-3 text-xs text-stone-400">
            <span>Chia sẻ bài viết:</span>
            <button class="w-8 h-8 rounded-full bg-stone-800 text-stone-300 hover:text-amber-400 flex items-center justify-center">
                <i class="fa-brands fa-facebook-f"></i>
            </button>
            <button class="w-8 h-8 rounded-full bg-stone-800 text-stone-300 hover:text-amber-400 flex items-center justify-center">
                <i class="fa-brands fa-twitter"></i>
            </button>
        </div>
    </div>

    <!-- Related Articles -->
    @if (tinLienQuan != null && tinLienQuan.Any())
    {
        <div class="mt-16 pt-12 border-t border-stone-800">
            <h2 class="text-xl font-bold text-stone-100 mb-6">Bài Viết Khác Cùng Chuyên Mục</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                @foreach (var r in tinLienQuan)
                {
                    <a href="/tin-tuc/@r.DuongDanSlug" class="group bg-thaicard border border-stone-800 rounded-2xl overflow-hidden hover:border-amber-500/40 transition">
                        <img src="@r.HinhAnhWebP" alt="@r.TieuDe" class="w-full h-32 object-cover" loading="lazy" />
                        <div class="p-4">
                            <h3 class="text-xs font-bold text-stone-200 line-clamp-2 group-hover:text-amber-400 transition-colors">
                                @r.TieuDe
                            </h3>
                            <span class="text-[10px] text-stone-500 font-mono mt-2 block">@r.NgayTao.ToString("dd/MM/yyyy")</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</article>

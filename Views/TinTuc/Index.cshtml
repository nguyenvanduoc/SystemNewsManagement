@model IReadOnlyList<ThaiBeer.Core.Domain.Entities.BaiViet>
@{
    ViewData["Title"] = "Tin Tức & Sự Kiện";
    ViewData["Description"] = "Cập nhật các thông cáo báo chí, hoạt động văn hóa và sự kiện thương hiệu mới nhất.";
}

<div class="bg-[#E5E8E7] border-b border-gray-300 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-[#666666] mb-3">
            <a href="/" class="hover:text-[#007A29] transition">Trang Chủ</a>
            <span>/</span>
            <span class="text-[#222222] font-semibold">Tin Tức</span>
        </nav>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#222222] uppercase tracking-tight">TIN TỨC & SỰ KIỆN</h1>
        <div class="w-16 h-1 bg-[#007A29] mt-3"></div>
        <p class="text-xs sm:text-sm text-[#555555] mt-3 max-w-2xl">
            Cập nhật những thông cáo báo chí, hoạt động phát triển bền vững và câu chuyện văn hóa thưởng thức đồ uống đậm đà.
        </p>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var tin in Model)
        {
            <article class="bg-white border border-gray-200 rounded-xl overflow-hidden group hover:border-[#007A29] transition-all duration-300 shadow-sm hover:shadow-md flex flex-col justify-between">
                <div>
                    <div class="aspect-video overflow-hidden">
                        <img src="@tin.HinhAnhWebP" alt="@tin.TieuDe" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                    </div>
                    <div class="p-6">
                        <div class="flex items-center gap-2 text-[11px] text-[#666666] font-['Montserrat',sans-serif] mb-2">
                            <span><i class="fa-regular fa-calendar mr-1 text-gray-400"></i> @tin.NgayTao.ToString("dd/MM/yyyy")</span>
                            <span class="text-gray-300">•</span>
                            <span>@tin.TacGia</span>
                        </div>
                        <h2 class="text-base font-bold text-[#222222] line-clamp-2 group-hover:text-[#007A29] transition-colors leading-snug">
                            <a href="/tin-tuc/@tin.DuongDanSlug">@tin.TieuDe</a>
                        </h2>
                        <p class="text-xs text-[#666666] mt-3 line-clamp-3 leading-relaxed">
                            @tin.TomTat
                        </p>
                    </div>
                </div>

                <div class="p-6 pt-0">
                    <a href="/tin-tuc/@tin.DuongDanSlug" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#007A29] hover:underline">
                        Đọc toàn bộ bài viết <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </a>
                </div>
            </article>
        }
    </div>
</div>


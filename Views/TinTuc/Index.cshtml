@model IReadOnlyList<ThaiBeer.Core.Domain.Entities.BaiViet>
@{
    ViewData["Title"] = "Văn Hóa & Tin Tức Bia Thái";
    ViewData["Description"] = "Cập nhật các bài viết về văn hóa ẩm thực Thái Lan, nghệ thuật nấu bia và sự kiện thương hiệu ThaiBeer.";
}

<div class="bg-thaicard border-b border-stone-800 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="text-xs text-amber-400 font-bold tracking-[0.25em] uppercase">Góc Tri Thức & Văn Hóa</span>
        <h1 class="text-3xl sm:text-4xl font-black text-stone-100 mt-2">Tin Tức & Văn Hóa Thưởng Thức</h1>
        <p class="text-xs sm:text-sm text-stone-400 mt-2 max-w-2xl">
            Khám phá câu chuyện đằng sau từng mẻ bia ThaiBeer và phong vị ẩm thực đặc sắc xứ sở Chùa Vàng.
        </p>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var tin in Model)
        {
            <article class="bg-thaicard border border-stone-800 rounded-3xl overflow-hidden group hover:border-amber-500/50 transition-all duration-300 shadow-xl flex flex-col justify-between">
                <div>
                    <div class="aspect-video overflow-hidden">
                        <img src="@tin.HinhAnhWebP" alt="@tin.TieuDe" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                    </div>
                    <div class="p-6">
                        <div class="flex items-center gap-2 text-[11px] text-stone-500 font-mono mb-2">
                            <span>@tin.NgayTao.ToString("dd/MM/yyyy")</span>
                            <span>•</span>
                            <span>@tin.TacGia</span>
                        </div>
                        <h2 class="text-lg font-bold text-stone-100 line-clamp-2 group-hover:text-amber-400 transition-colors">
                            <a href="/tin-tuc/@tin.DuongDanSlug">@tin.TieuDe</a>
                        </h2>
                        <p class="text-xs text-stone-400 mt-3 line-clamp-3 leading-relaxed">
                            @tin.TomTat
                        </p>
                    </div>
                </div>

                <div class="p-6 pt-0">
                    <a href="/tin-tuc/@tin.DuongDanSlug" class="inline-flex items-center gap-2 text-xs font-bold text-amber-400 hover:underline">
                        Đọc toàn bộ bài viết <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </a>
                </div>
            </article>
        }
    </div>
</div>

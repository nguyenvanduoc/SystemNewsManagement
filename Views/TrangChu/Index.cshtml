@model ThaiBeer.ViewModels.TrangChuViewModel
@{
    ViewData["Title"] = "Trang Chủ - Hương Vị Đẳng Cấp Thượng Hạng";
    ViewData["Description"] = "Trải nghiệm dòng bia trứ danh với vị đắng êm dịu, bọt tuyết mịn màng và nguồn hoa bia Saaz quý tộc.";
}

<!-- 1. Hero Banner Video (Chuẩn 100% ThaiBeer.vn - Phát video introbeer tĩnh) -->
<section class="relative w-full bg-black overflow-hidden shadow-sm">
    <div class="relative w-full h-[45vh] sm:h-[60vh] lg:h-[72vh] min-h-[300px] max-h-[850px] flex items-center justify-center">
        <video id="videoId" 
               class="w-full h-full object-cover" 
               autoplay 
               loop 
               muted 
               playsinline 
               webkit-playsinline 
               preload="auto">
            <source src="~/images/logo/introbeer-6545-1782743922.mp4" type="video/mp4" />
            Trình duyệt không hỗ trợ phát video banner.
        </video>
    </div>
</section>

@* 
<!-- 2. BỘ SƯU TẬP DÒNG SẢN PHẨM (Đã ẩn theo yêu cầu của người dùng) -->
<section class="hidden py-10 sm:py-20 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header Bộ Sưu Tập Dòng Sản Phẩm -->
        <div class="mb-8 sm:mb-14">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#111111] tracking-tight uppercase">
                BỘ SƯU TẬP DÒNG SẢN PHẨM
            </h2>
            <div class="w-16 h-1 bg-[#007A29] mt-3 rounded-full"></div>
            <p class="text-xs sm:text-sm text-[#666666] mt-3 font-normal">
                Đa dạng dung tích và phong cách thưởng thức đáp ứng mọi khẩu vị
            </p>
        </div>

        <!-- 1. GIAO DIỆN MOBILE: Chỉ hiển thị 1 card và có thanh kéo trái (Swiper 1 slide + Draggable Scrollbar) -->
        <div class="md:hidden">
            <div class="swiper category-swiper overflow-hidden px-1 py-2">
                <div class="swiper-wrapper">
                    @foreach (var dm in Model.DanhSachDanhMuc)
                    {
                        var toneColor = string.IsNullOrWhiteSpace(dm.ToneMau) ? "#007A29" : dm.ToneMau;
                        <div class="swiper-slide h-auto">
                            <a href="/danh-muc/@dm.DuongDanSlug" class="block h-full rounded-2xl bg-white border border-gray-200 p-6 shadow-sm active:scale-[0.99] transition-all flex flex-col justify-between" style="--tone: @toneColor; border-color: @(toneColor)40;">
                                <div>
                                    <!-- Ô icon cốc bia bo góc tròn mềm mại nền nhạt theo tone màu -->
                                    <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-2xl mb-5" style="background-color: @(toneColor)18; color: @toneColor;">
                                        <i class="fa-solid fa-beer-mug-empty"></i>
                                    </div>

                                    <!-- Tên dòng sản phẩm -->
                                    <h3 class="text-xl font-extrabold text-[#222222]" style="color: @toneColor;">
                                        @dm.TenDanhMuc
                                    </h3>

                                    <!-- Mô tả dòng sản phẩm -->
                                    <p class="text-xs text-[#666666] mt-3 leading-relaxed">
                                        @dm.MoTa
                                    </p>
                                </div>

                                <!-- Link Khám phá dòng bia có màu theo tone màu -->
                                <div class="mt-6 pt-2 flex items-center gap-1.5 text-xs font-bold" style="color: @toneColor;">
                                    <span>Khám phá dòng bia</span>
                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </div>
                            </a>
                        </div>
                    }
                </div>

                <!-- Thanh Kéo Trái (Draggable Scrollbar) -->
                <div class="category-scrollbar swiper-scrollbar"></div>
                
                <!-- Gợi ý kéo trái mượt mà -->
                <div class="flex items-center justify-between text-[11px] text-gray-400 mt-3 px-1">
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-hand-pointer text-gray-400"></i>
                        Kéo thanh trượt hoặc vuốt sang trái
                    </span>
                    <span class="font-mono text-gray-400" id="categorySlideCounter">1 / @Model.DanhSachDanhMuc.Count</span>
                </div>
            </div>
        </div>

        <!-- 2. GIAO DIỆN DESKTOP / TABLET: Dạng Lưới Grid 4 Cột Sang Trọng -->
        <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var dm in Model.DanhSachDanhMuc)
            {
                var toneColor = string.IsNullOrWhiteSpace(dm.ToneMau) ? "#007A29" : dm.ToneMau;
                <a href="/danh-muc/@dm.DuongDanSlug" class="group relative rounded-2xl bg-white border border-gray-200 p-7 hover:border-[var(--tone)] hover:shadow-lg transition-all duration-300 hover:-translate-y-1 shadow-sm flex flex-col justify-between" style="--tone: @toneColor;">
                    <div>
                        <!-- Ô vuông icon cốc bia bo góc tròn mềm mại nền nhạt theo tone màu -->
                        <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform duration-300" style="background-color: @(toneColor)18; color: @toneColor;">
                            <i class="fa-solid fa-beer-mug-empty"></i>
                        </div>

                        <!-- Tên dòng sản phẩm -->
                        <h3 class="text-lg sm:text-xl font-extrabold text-[#222222] transition-colors group-hover:text-[var(--tone)]">
                            @dm.TenDanhMuc
                        </h3>

                        <!-- Mô tả dòng sản phẩm -->
                        <p class="text-xs sm:text-sm text-[#666666] mt-2.5 leading-relaxed">
                            @dm.MoTa
                        </p>
                    </div>

                    <!-- Link Khám phá dòng bia có màu theo tone màu -->
                    <div class="mt-6 flex items-center gap-1.5 text-xs sm:text-sm font-bold group-hover:translate-x-1 transition-transform" style="color: @toneColor;">
                        <span>Khám phá dòng bia</span>
                        <i class="fa-solid fa-arrow-right text-[11px]"></i>
                    </div>
                </a>
            }
        </div>
    </div>
</section>
*@

<!-- 3. SẢN PHẨM NỔI BẬT (Dạng card nhỏ có màu sắc và hình ảnh thu gọn chuẩn 100% theo ảnh của khách) -->
<section class="pt-5 pb-10 sm:pt-8 sm:pb-14 bg-white">
    <div class="max-w-[1700px] w-full mx-auto px-4 sm:px-6 lg:px-10 xl:px-14">
        <!-- Header Căn Giữa (Đã bỏ chữ THAI BEER và rút gọn khoảng cách) -->
        <div class="text-center mb-4 sm:mb-6">
            <h2 class="text-2xl sm:text-3xl font-black text-[#111111] uppercase tracking-tight">
                SẢN PHẨM NỔI BẬT
            </h2>
        </div>

        <!-- 1. GIAO DIỆN MOBILE: Chỉ hiển thị 1 Card sản phẩm và có thanh kéo trái (Swiper 1 Slide + Draggable Scrollbar) -->
        <div class="md:hidden">
            <div class="swiper product-swiper overflow-hidden px-1 py-2">
                <div class="swiper-wrapper">
                    @for (int idx = 0; idx < Model.SanPhamNoiBat.Count; idx++)
                    {
                        var sp = Model.SanPhamNoiBat[idx];
                        var bgColors = new[] { "#007A29", "#900C13", "#D97706", "#005A1E" };
                        var cardBg = bgColors[idx % bgColors.Length];

                        <div class="swiper-slide h-auto">
                            <div class="rounded-3xl p-5 text-white relative overflow-hidden shadow-xl flex flex-col justify-between min-h-[290px] h-full" style="background-color: @cardBg;">
                                <!-- Hàng 1: Tiêu Đề Nằm Trên Cùng Trải Rộng -->
                                <div>
                                    <h3 class="text-lg sm:text-xl font-black tracking-tight leading-tight uppercase line-clamp-2 text-white">
                                        @sp.TenSanPham
                                    </h3>
                                </div>

                                <!-- Hàng 2: Nội Dung Nằm Dưới Tiêu Đề (Trái: Mô Tả & Nút / Phải: Thùng Bia Nền Trắng) -->
                                <div class="flex items-end justify-between gap-3 pt-3 flex-1">
                                    <!-- Cột Trái: Mô Tả và Nút Xem Chi Tiết -->
                                    <div class="flex-1 flex flex-col justify-between h-full space-y-2.5">
                                        <p class="text-xs text-white/90 font-medium leading-relaxed line-clamp-3 sm:line-clamp-4">
                                            @(sp.MoTaNgan ?? "Mẫu lon: Thấp (Lùn) Thành phần: Nước, mạch nha đại mạch, hoa bia, men bia. Hướng dẫn sử dụng...")
                                        </p>
                                        <div class="pt-1.5 mt-auto">
                                            <a href="/san-pham/@sp.DuongDanSlug" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-white/90 bg-transparent text-white text-[11px] font-black uppercase tracking-wider transition-all shadow-sm active:scale-95" style="color: #ffffff !important; border-color: #ffffff !important;">
                                                <span style="color: #ffffff !important; font-weight: 800;">XEM CHI TIẾT</span>
                                                <i class="fa-solid fa-play text-[7px]" style="color: #ffffff !important;"></i>
                                            </a>
                                        </div>
                                    </div>

                                    <!-- Cột Phải: Khung Hình Ảnh Thùng Bia Nền Trắng (Tăng Size To Rõ Hơn Nữa) -->
                                    <div class="relative shrink-0">
                                        <div class="w-44 h-44 sm:w-48 sm:h-48 rounded-2xl bg-white p-1.5 flex items-center justify-center overflow-hidden shadow-md">
                                            <img src="@sp.HinhAnhWebP" alt="@sp.TenSanPham" class="w-full h-full object-contain filter drop-shadow-sm scale-110" loading="lazy" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Thanh Kéo Trái (Draggable Scrollbar) -->
                <div class="product-scrollbar swiper-scrollbar"></div>
                
                <!-- Gợi ý kéo trái mượt mà -->
                <div class="flex items-center justify-between text-[11px] text-gray-400 mt-3 px-1">
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-hand-pointer text-gray-400"></i>
                        Kéo thanh trượt hoặc vuốt sang trái
                    </span>
                    <span class="font-mono text-gray-400" id="productSlideCounter">1 / @Model.SanPhamNoiBat.Count</span>
                </div>
            </div>
        </div>

        <!-- 2. GIAO DIỆN DESKTOP / TABLET: Chia Làm 4 Phần (Grid 4 Cột) Với Khung Hình Ảnh To Rõ Nét -->
        <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
            @for (int idx = 0; idx < Model.SanPhamNoiBat.Count; idx++)
            {
                var sp = Model.SanPhamNoiBat[idx];
                var bgColors = new[] { "#007A29", "#900C13", "#D97706", "#005A1E" };
                var cardBg = bgColors[idx % bgColors.Length];

                <div class="rounded-3xl p-5 text-white relative overflow-hidden shadow-md transition-all duration-300 hover:shadow-xl hover:-translate-y-1 flex flex-col justify-between min-h-[275px]" style="background-color: @cardBg;">
                    <!-- Hàng 1: Tiêu Đề Nằm Trên Cùng Trải Rộng -->
                    <div>
                        <h3 class="text-base sm:text-lg font-black tracking-tight leading-tight uppercase line-clamp-2 text-white">
                            @sp.TenSanPham
                        </h3>
                    </div>

                    <!-- Hàng 2: Nội Dung Nằm Dưới Tiêu Đề (Trái: Mô Tả & Nút / Phải: Thùng Bia Nền Trắng To Đẹp) -->
                    <div class="flex items-end justify-between gap-3 pt-3 flex-1">
                        <!-- Cột Trái: Mô Tả và Nút Xem Chi Tiết -->
                        <div class="flex-1 flex flex-col justify-between h-full space-y-2.5">
                            <p class="text-[11px] sm:text-xs text-white/90 font-medium leading-snug line-clamp-3">
                                @(sp.MoTaNgan ?? "Mẫu lon: Thấp (Lùn) Thành phần: Nước, mạch nha đại mạch, hoa bia, men bia...")
                            </p>
                            <div class="pt-1.5 mt-auto">
                                <a href="/san-pham/@sp.DuongDanSlug" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-white/90 bg-transparent text-white text-[10px] sm:text-[11px] font-black uppercase tracking-wider hover:bg-white hover:text-[#007A29] transition-all shadow-sm" style="color: #ffffff !important; border-color: #ffffff !important;">
                                    <span style="color: #ffffff !important; font-weight: 800;">XEM CHI TIẾT</span>
                                    <i class="fa-solid fa-play text-[7px]" style="color: #ffffff !important;"></i>
                                </a>
                            </div>
                        </div>

                        <!-- Cột Phải: Khung Hình Ảnh Thùng Bia Nền Trắng (Tăng Size Lên To Rõ) -->
                        <div class="relative shrink-0">
                            <div class="w-32 h-32 sm:w-36 sm:h-36 lg:w-40 lg:h-40 xl:w-44 xl:h-44 rounded-2xl bg-white p-2.5 flex items-center justify-center overflow-hidden shadow-md">
                                <img src="@sp.HinhAnhWebP" alt="@sp.TenSanPham" class="max-h-full max-w-full object-contain filter drop-shadow-sm" loading="lazy" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-10">
            <a href="/san-pham" class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-white hover:bg-[#007A29] hover:text-white border border-gray-300 text-[#222222] text-xs font-bold tracking-wider uppercase transition shadow-sm">
                Xem Toàn Bộ Sản Phẩm <i class="fa-solid fa-arrow-right text-[11px]"></i>
            </a>
        </div>
    </div>
</section>

<!-- 4. VỀ THAI BEER - CÔNG TY CỔ PHẦN BIA & NƯỚC GIẢI KHÁT SÀI GÒN CỬU LONG (Chuẩn 100% theo ảnh khách cung cấp: Full tràn viền & Dài hơn) -->
<section class="relative bg-[#F8F9FA] border-y border-gray-200 overflow-hidden py-0">
    <div class="w-full">
        <div class="grid grid-cols-1 lg:grid-cols-12 items-center min-h-[480px] lg:min-h-[540px] xl:min-h-[580px]">
            <!-- Cột Trái: Ảnh banner du lịch tràn sát viền bên trái, hiển thị đầy đủ trọn vẹn toàn bộ người và tăng chiều dài -->
            <div class="lg:col-span-7 xl:col-span-8 relative h-full flex items-center justify-start overflow-hidden">
                <div class="relative w-full h-full min-h-[300px] sm:min-h-[420px] lg:min-h-[540px] xl:min-h-[580px] flex items-center">
                    <img src="~/images/bannerdulich.webp.webp" 
                         asp-append-version="true" 
                         alt="Công ty Cổ phần Bia & Nước giải khát Sài Gòn Cửu Long tham quan nhà máy bia Vinaken" 
                         class="w-full h-full object-cover object-left" 
                         style="-webkit-mask-image: linear-gradient(to right, rgba(0,0,0,1) 88%, rgba(0,0,0,0) 100%); mask-image: linear-gradient(to right, rgba(0,0,0,1) 88%, rgba(0,0,0,0) 100%);" 
                         loading="lazy" />
                    <!-- Lớp phủ Gradient mờ dần từ ảnh sang nền (Hiển thị mượt mà trên desktop) -->
                    <div class="hidden lg:block absolute inset-y-0 right-0 w-20 xl:w-32 bg-gradient-to-r from-transparent to-[#F8F9FA] pointer-events-none"></div>
                </div>
            </div>

            <!-- Cột Phải: Nội dung Giới thiệu chuẩn 100% theo ảnh của khách cung cấp -->
            <div class="lg:col-span-5 xl:col-span-4 px-6 sm:px-10 lg:pl-6 lg:pr-12 xl:pr-16 2xl:pr-24 py-8 lg:py-12 space-y-4 xl:space-y-5">
                <div>
                    <span class="text-xs sm:text-sm font-extrabold uppercase tracking-wider block mb-2" style="color: #B30D14;">
                        VỀ THAI BEER
                    </span>
                    <h2 class="text-2xl sm:text-3xl xl:text-[34px] font-black text-[#111111] uppercase tracking-tight leading-tight sm:leading-tight">
                        CÔNG TY CỔ PHẦN BIA & NƯỚC GIẢI KHÁT SÀI GÒN CỬU LONG
                    </h2>
                </div>

                <p class="text-xs sm:text-sm xl:text-[14.5px] leading-relaxed sm:leading-[26px] text-[#333333] font-normal text-justify sm:text-left">
                    Với đội ngũ cán bộ, công nhân viên có trình độ tay nghề cao, các thiết bị máy móc hiện đại, đã cập nhật các kiến thức mới, hiện đại, biết phát huy nguồn lực tri thức cao và nội lực sáng tạo Việt Nam, làm chủ được nhanh chóng công nghệ mới. Trong suốt quá trình kinh doanh, luôn lấy chất lượng và an toàn vệ sinh thực phẩm tạo nên sự uy tín và sự phát triển bền vững là tiêu chí hàng đầu để đến với khách hàng.
                </p>

                <div class="pt-2">
                    <a href="/lien-he" class="inline-flex items-center gap-2 px-6 py-2.5 sm:px-7 sm:py-3 rounded-lg text-white text-xs sm:text-sm font-bold uppercase tracking-wider shadow-md hover:shadow-lg hover:scale-105 active:scale-95 transition-all" style="background-color: #B30D14;">
                        <span>TÌM HIỂU THÊM</span>
                        <i class="fa-solid fa-play text-[8px] sm:text-[9px] text-white"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@*
<!-- 4b. Nghệ Thuật Nấu Bia & Phát Triển Bền Vững (Đã ẩn theo yêu cầu) -->
<section class="py-20 bg-white border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <!-- Left image collage -->
            <div class="relative">
                <img src="https://images.unsplash.com/photo-1571613316887-6f8d5cbf7ef7?q=80&w=800&auto=format&fit=crop" alt="Quy trình nấu men bia thượng hạng" class="rounded-2xl shadow-lg border border-gray-200 w-full object-cover max-h-[440px]" loading="lazy" />
                <div class="absolute -bottom-5 -right-5 hidden sm:block p-5 rounded-xl bg-white border border-gray-200 max-w-xs shadow-xl">
                    <div class="flex items-center gap-3 mb-2">

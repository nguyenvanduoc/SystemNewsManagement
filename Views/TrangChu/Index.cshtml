<!-- 5. Tin Tức & Thông Cáo Báo Chí (Rộng bằng banner chuẩn max-w-[1700px]) -->
<section class="py-14 sm:py-20 bg-[#F4F4F4]">
    <div class="max-w-[1700px] w-full mx-auto px-4 sm:px-6 lg:px-10 xl:px-14">
        <div class="reveal-on-scroll flex items-end justify-between mb-8 sm:mb-12">
            <div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-[#222222] tracking-tight uppercase">
                    TIN TỨC & SỰ KIỆN
                </h2>
                <div class="w-16 h-1 bg-[#007A29] mt-3"></div>
            </div>
            <a href="/tin-tuc" class="text-xs sm:text-sm text-[#007A29] hover:underline font-bold hidden sm:inline-flex items-center gap-1.5">
                <span>Xem tất cả bài viết</span>
                <i class="fa-solid fa-arrow-right text-[11px]"></i>
            </a>
        </div>

        <!-- 1. GIAO DIỆN MOBILE: Chỉ mặc định hiển thị 1 Card tin tức và kéo vuốt sang trái (Swiper 1 Slide + Draggable Scrollbar) -->
        <div class="md:hidden">
            <div class="reveal-on-scroll swiper news-swiper overflow-hidden px-1 py-2">
                <div class="swiper-wrapper">
                    @foreach (var tin in Model.TinTucNoiBat)
                    {
                        <div class="swiper-slide h-auto">
                            <article class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-md flex flex-col justify-between h-full">
                                <div>
                                    <div class="aspect-video overflow-hidden">
                                        <img src="@tin.HinhAnhWebP" alt="@tin.TieuDe" class="w-full h-full object-cover" loading="lazy" />
                                    </div>
                                    <div class="p-5 bg-white">
                                        <span class="text-[11px] text-[#666666] font-mono block mb-1.5">
                                            <i class="fa-regular fa-calendar mr-1"></i> @tin.NgayTao.ToString("dd/MM/yyyy")
                                        </span>
                                        <h3 class="text-base font-bold text-[#222222] mt-1 line-clamp-2 leading-snug">
                                            <a href="/tin-tuc/@tin.DuongDanSlug">@tin.TieuDe</a>
                                        </h3>
                                        <p class="text-xs text-[#666666] mt-2.5 line-clamp-3 leading-relaxed">
                                            @tin.TomTat
                                        </p>
                                    </div>
                                </div>
                                <div class="px-5 pb-5 pt-1 bg-white">
                                    <a href="/tin-tuc/@tin.DuongDanSlug" class="text-xs text-[#007A29] font-bold hover:underline inline-flex items-center gap-1.5">
                                        Đọc chi tiết <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                    </a>
                                </div>
                            </article>
                        </div>
                    }
                </div>

                <!-- Thanh Kéo Trái (Draggable Scrollbar) -->
                <div class="news-scrollbar swiper-scrollbar"></div>
                
                <!-- Gợi ý kéo trái mượt mà -->
                <div class="flex items-center justify-between text-[11px] text-gray-400 mt-3 px-1">
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-hand-pointer text-gray-400"></i>
                        Kéo thanh trượt hoặc vuốt sang trái
                    </span>
                    <span class="font-mono text-gray-400" id="newsSlideCounter">1 / @Model.TinTucNoiBat.Count</span>
                </div>
            </div>

            <!-- Nút xem tất cả bài viết trên Mobile -->
            <div class="text-center mt-6">
                <a href="/tin-tuc" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-white hover:bg-[#007A29] hover:text-white border border-gray-300 text-[#222222] text-xs font-bold tracking-wider uppercase transition shadow-sm">
                    <span>Xem tất cả bài viết</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
            </div>
        </div>


@model ThaiBeer.ViewModels.UngTuyenViewModel
@{
    ViewData["Title"] = "Tuyển Dụng Nhân Tài - Cơ Hội Nghề Nghiệp ThaiBeer";
    ViewData["Description"] = "Cơ hội việc làm hấp dẫn tại ThaiBeer: Tuyển Quản lý kinh doanh khu vực (ASM), Nhân viên Sales thị trường tại khu vực Miền Trung, Miền Nam, Miền Tây. Thu nhập thỏa thuận cạnh tranh, đãi ngộ tốt.";
}

<!-- Header Banner (Tone Xanh Thương Hiệu) -->
<div class="bg-[#EBF0FA] border-b border-blue-100 py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-[#666666] mb-3">
            <a href="/" class="hover:text-[#133089] transition">Trang Chủ</a>
            <span>/</span>
            <span class="text-[#222222] font-semibold">Tuyển Dụng</span>
        </nav>
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
